---
/**
 * <head> commun : métas SEO, OpenGraph + Twitter cards, canonical, favicon,
 * données structurées schema.org (BedAndBreakfast / LodgingBusiness) et, option,
 * analytics Plausible (sans cookie).
 */
import { site } from "../data/site";
import { withBase } from "../utils/url";

interface Props {
  title: string;
  description: string;
  /** Image OG relative à la racine du site (défaut : /og-default.jpg). */
  image?: string;
  /** og:type (website par défaut, article pour les pages éditoriales). */
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og-default.jpg",
  ogType = "website",
  noindex = false,
} = Astro.props;

// Normalise le chemin pour une URL canonique propre (sans .html ni slash final).
let path = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
if (path.length > 1) path = path.replace(/\/$/, "");
const canonical = new URL(path === "" ? "/" : path, Astro.site).href;
const ogImage = new URL(withBase(image), Astro.site).href;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

// Données structurées : maison d'hôtes (LodgingBusiness / BedAndBreakfast).
// ⚠️ Ni streetAddress ni code postal (résidence habitée) — localité/région.
// ⚠️ Ni streetAddress ni téléphone : la demeure reste habitée.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["BedAndBreakfast", "LodgingBusiness"],
  name: site.name,
  alternateName: site.signature,
  description: site.tagline,
  url: new URL(withBase("/"), Astro.site).href,
  image: ogImage,
  email: site.contact.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.location.locality,
    addressRegion: site.location.region,
    addressCountry: site.location.country,
  },
  areaServed: [site.location.region, "Lorraine", site.location.area],
  numberOfRooms: 2,
  priceRange: "200 € la nuit",
  petsAllowed: false,
  smokingAllowed: false,
  amenityFeature: [
    { "@type": "LocationFeatureSpecification", name: "Piscine naturelle", value: true },
    { "@type": "LocationFeatureSpecification", name: "Parc boisé clos", value: true },
    { "@type": "LocationFeatureSpecification", name: "Dîner sur réservation", value: true },
    { "@type": "LocationFeatureSpecification", name: "Hammam", value: true },
    { "@type": "LocationFeatureSpecification", name: "Bain nordique", value: true },
    { "@type": "LocationFeatureSpecification", name: "Sauna finlandais", value: true },
  ],
  knowsLanguage: "fr-FR",
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#141f26" />

<!-- Favicon (blason) -->
<link rel="icon" type="image/png" sizes="48x48" href={withBase("/favicon-48.png")} />
<link rel="icon" type="image/png" sizes="512x512" href={withBase("/icon-512.png")} />
<link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />

<!-- Sitemap -->
<link rel="sitemap" href={withBase("/sitemap-index.xml")} />

<!-- OpenGraph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="fr_FR" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Données structurées -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>

<!-- Analytics sans cookie (activé seulement si PUBLIC_PLAUSIBLE_DOMAIN est défini) -->
{
  plausibleDomain && (
    <script
      defer
      is:inline
      data-domain={plausibleDomain}
      src="https://plausible.io/js/script.js"
    />
  )
}
