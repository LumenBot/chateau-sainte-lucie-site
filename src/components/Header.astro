---
/**
 * En-tête + navigation. Blason définitif dans le lockup de marque.
 * `transparent` (défaut, sur hero sombre) / `solid` (pages claires).
 * Menu mobile accessible (case focusable + Échap).
 */
import { site, mainNav, ctaLabels } from "../data/site";
import { withBase, normalizePath } from "../utils/url";
import Blason from "./brand/Blason.astro";

interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
const crestVariant = solid ? "encre" : "or";

const path = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
  const target = normalizePath(withBase(href));
  return target === "/"
    ? path === target
    : path === target || path.startsWith(target + "/");
};
const bookingActive = isActive("/demo/reservation");
---

<input
  id="navchk"
  class="nav-check"
  type="checkbox"
  aria-label="Ouvrir le menu de navigation"
/>

<header class={`site-header${solid ? " solid" : ""}`}>
  <div class="bar">
    <a class="brand" href={withBase("/")} aria-label={`${site.name} — accueil`}>
      <Blason variant={crestVariant} width={46} loading="eager" class="crest" />
      <span class="brand-text">
        <span class="bn">{site.name}</span>
        <span class="bs">{site.signature}</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Navigation principale">
      {
        mainNav.map((item) => (
          <a
            class="navlink"
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="navlink" href={withBase("/contact")}>Contact</a>
      <a
        class={`btn btn--sm ${bookingActive ? "btn--gold-light" : "btn--ghost-light"}`}
        href={withBase("/demo/reservation")}
        aria-current={bookingActive ? "page" : undefined}
      >Faire ma réservation</a>
    </nav>

    <label class="nav-toggle" for="navchk" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>
  </div>
</header>

<div class="nav-mobile" id="menu-mobile">
  <div class="mtop">
    <span class="brand">
      <Blason variant="or" width={44} class="crest" />
      <span class="brand-text">
        <span class="bn">{site.name}</span>
        <span class="bs">{site.signature}</span>
      </span>
    </span>
    <label class="mclose" for="navchk" aria-label="Fermer le menu">×</label>
  </div>
  {
    mainNav.map((item) => (
      <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
        <span class="idx">{item.idx}</span>
      </a>
    ))
  }
  <div class="mcta">
    <a class="btn btn--gold-light" href={withBase("/demo/reservation")}>{ctaLabels.informer}</a>
    <a class="btn btn--ghost-light" href={withBase("/contact")}>Nous contacter</a>
  </div>
</div>

<script>
  // Amélioration progressive du menu mobile (le « checkbox hack » fonctionne
  // déjà sans JS ; ce script ajoute Échap et la fermeture au clic d'un lien).
  const cb = document.getElementById("navchk") as HTMLInputElement | null;
  if (cb) {
    const close = () => (cb.checked = false);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && cb.checked) close();
    });
    document
      .querySelectorAll(".nav-mobile a")
      .forEach((a) => a.addEventListener("click", close));
  }
</script>
