---
/**
 * Pied de page (registre nuit). Blason + marque, découverte, contact de
 * pré-ouverture (sans téléphone) et bas de page légal.
 */
import { site, footerDiscover, legalNav, ctaLabels } from "../data/site";
import { withBase } from "../utils/url";
import Blason from "./brand/Blason.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <Blason variant="or" width={64} class="foot-crest" />
        <div class="bn">{site.name}</div>
        <div class="bs">{site.signature}</div>
        <p>{site.tagline}</p>
      </div>

      <nav class="foot-col" aria-label="Découvrir">
        <h4>Découvrir</h4>
        {footerDiscover.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      </nav>

      <div class="foot-col">
        <h4>Contact</h4>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <p class="muted">{site.location.approx}</p>
        <p class="muted">Adresse exacte communiquée aux clients confirmés.</p>
        <p class="foot-opening">{site.opening.label}</p>
      </div>

      <div class="foot-col">
        <h4>Votre séjour</h4>
        <p>Recevez en priorité les premières dates disponibles, sans engagement.</p>
        <a class="btn btn--ghost-light btn--sm" href={withBase("/liste-attente")} style="margin-top:6px;">
          {ctaLabels.informer}
        </a>
        <a class="foot-demo" href={withBase("/demo/reservation")}>Découvrir le parcours en démonstration →</a>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} {site.house} — {site.name}. Tous droits réservés.</span>
      <span class="legal">
        {legalNav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      </span>
    </div>
  </div>
</footer>

<style>
  .foot-crest {
    height: 64px;
    width: auto;
    margin-bottom: 16px;
  }
  .foot-opening {
    color: var(--or) !important;
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 11px;
    margin-top: 14px;
  }
  .foot-demo {
    display: block;
    margin-top: 14px;
    color: var(--creme-dim);
    font-size: 12px;
  }
</style>
