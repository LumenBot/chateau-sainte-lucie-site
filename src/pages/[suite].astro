---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Icon from "../components/Icon.astro";
import ProjectionBadge from "../components/ProjectionBadge.astro";
import { resolveVisual } from "../data/images";
import { withBase } from "../utils/url";

export async function getStaticPaths() {
  const suites = await getCollection("suites");
  return suites.map((entry) => ({ params: { suite: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { hero } = data;
---

<BaseLayout title={data.seo.title} description={data.seo.description} ogType="article">
  <PageHero
    place={hero.eyebrow}
    title={[hero.title]}
    lead={hero.lead}
    image={hero.image}
    imageAlt={hero.imageAlt}
    imagePosition={hero.imagePosition}
    actions={[
      { label: "Rejoindre la liste d’attente", href: "/liste-attente", variant: "gold-light" },
      { label: "Découvrir le parcours", href: "/demo/reservation", variant: "ghost-light" },
    ]}
  />

  <section class="sec suite-body">
    <div class="wrap">
      <div class="suite-grid">
        <div class="suite-lead">
          <p class="eyebrow"><span class="ln"></span>La suite</p>
          <p class="lede">{data.intro}</p>
          <p class="suite-palette">{data.palette}</p>
          <ul class="suite-ambiance">
            {data.ambiance.map((a) => <li>{a}</li>)}
          </ul>
        </div>
        <div class="suite-compo">
          <h2 class="display-m">La composition</h2>
          <ul class="compo-list">
            {
              data.composition.map((c) => (
                <li>
                  <span class="ic"><Icon name="check" size={18} /></span>
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
          <p class="note suite-confirm">{data.aConfirmer}</p>
        </div>
      </div>

      <div class="suite-offer">
        <div>
          <span class="suite-offer__eyebrow">La nuit</span>
          <strong>180–220 €</strong>
          <span>selon la période · pour un ou deux adultes · petit-déjeuner, parc et piscine inclus</span>
        </div>
        <div>
          <span class="suite-offer__eyebrow">Avec des enfants</span>
          <strong>+ 20 €</strong>
          <span>par enfant et par nuit · petit-déjeuner inclus · deux maximum</span>
        </div>
        <div>
          <span class="suite-offer__eyebrow">Sur réservation</span>
          <strong>+ 50 €</strong>
          <span>par suite et par jour · hammam et bain nordique · + 20 € / personne supplémentaire</span>
        </div>
        <div>
          <span class="suite-offer__eyebrow">Planche du territoire</span>
          <strong>+ 50 €</strong>
          <span>par suite et par service · composition à finaliser</span>
        </div>
      </div>
      <p class="note suite-conditions">Taxe de séjour en sus. Arrivée à partir de 15 h ; arrivée anticipée à 14 h sur demande ; départ avant 12 h. <a href={withBase("/conditions-sejour")}>Lire les conditions prévisionnelles.</a></p>

      <p class="suite-nav">
        <a class="link-or" href={withBase("/les-suites")}>
          <span class="arr">←</span> Revenir aux deux suites
        </a>
      </p>
    </div>
  </section>

  {
    data.renders.length > 0 && (
      <section class="sec suite-renders">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow"><span class="ln" />Visite en images</p>
            <h2 class="display-l">La suite {data.nav}, <em class="gold">en projection.</em></h2>
            <p class="proj-note">
              Visuels de projection non contractuels, réalisés à partir des
              photographies, vidéos et plans du lieu. L'aménagement final pourra
              différer ; les photographies définitives seront réalisées après les
              travaux, en mars 2027.
            </p>
          </div>
          <div class="renders-grid">
            {data.renders.map((r) => {
              const v = resolveVisual(r.image);
              return (
                <figure class="render-item">
                  <div class="render-media">
                    <Image
                      src={v.src}
                      alt={v.alt}
                      widths={[400, 700, 1000]}
                      sizes="(min-width:820px) 33vw, 100vw"
                      loading="lazy"
                    />
                    <ProjectionBadge />
                  </div>
                  <figcaption>{r.caption}</figcaption>
                </figure>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <CtaFinal
    eyebrow="Votre séjour · avril 2027"
    titleLead="Composez votre "
    titleGold="première nuit."
    text="Inscrivez-vous pour recevoir les premières dates disponibles ou explorez les choix qui personnaliseront votre séjour dans la démonstration."
    actions={[
      { label: "Rejoindre la liste d’attente", href: "/liste-attente", variant: "gold-light" },
      { label: "Découvrir le parcours", href: "/demo/reservation", variant: "ghost-light" },
    ]}
  />
</BaseLayout>

<style>
  .suite-body {
    background: var(--parch);
  }
  .suite-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 42px;
  }
  @media (min-width: 880px) {
    .suite-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 64px;
    }
  }
  .suite-lead .lede {
    margin-top: 22px;
  }
  .suite-palette {
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(19px, 2.2vw, 24px);
    color: var(--or-prof);
    margin: 6px 0 18px;
  }
  .suite-ambiance {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .suite-ambiance li {
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 10.5px;
    color: var(--or-prof);
    border: 1px solid var(--rule-l);
    padding: 5px 11px;
  }
  .suite-compo h2 {
    margin: 0 0 22px;
  }
  .compo-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .compo-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 17px;
    color: var(--encre-soft);
    line-height: 1.5;
  }
  .compo-list .ic {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border: 1px solid var(--rule-l);
    display: grid;
    place-items: center;
    color: var(--or-prof);
  }
  .suite-confirm {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-l-faint);
  }
  .suite-photo-note {
    text-align: center;
    margin-top: 48px;
  }
  .suite-nav {
    margin-top: 22px;
    text-align: center;
  }
  .suite-conditions {
    margin: 0 auto 22px;
    max-width: 900px;
    text-align: center;
  }
  .suite-conditions a { color: var(--or-prof); }
  .suite-offer {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--rule-l-faint);
    border: 1px solid var(--rule-l-faint);
    margin: 48px 0 26px;
  }
  .suite-offer > div {
    background: var(--parch-card);
    padding: 25px;
    display: flex;
    flex-direction: column;
  }
  .suite-offer__eyebrow {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .2em;
    color: var(--encre-faint);
  }
  .suite-offer strong {
    font-family: var(--display);
    font-weight: 500;
    font-size: 36px;
    line-height: 1;
    color: var(--or-prof);
    margin: 12px 0 6px;
  }
  .suite-offer > div > span:last-child {
    color: var(--encre-soft);
    font-size: 14px;
  }
  @media (min-width: 740px) {
    .suite-offer { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1050px) {
    .suite-offer { grid-template-columns: repeat(5, 1fr); }
    .suite-offer > div { padding: 21px; }
  }

  /* galerie de rendus de projection */
  .suite-renders {
    background: var(--parch-2);
  }
  .suite-renders .sec-head {
    max-width: 720px;
  }
  .suite-renders h2 {
    margin: 16px 0 14px;
  }
  .renders-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    margin-top: 40px;
  }
  .render-item {
    margin: 0;
  }
  .render-media {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border: 1px solid var(--rule-l-faint);
  }
  .render-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .render-item figcaption {
    font-family: var(--serif);
    font-size: 14px;
    color: var(--encre-soft);
    margin-top: 10px;
  }
  @media (min-width: 620px) {
    .renders-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .renders-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .render-item:first-child {
      grid-column: span 2;
    }
    .render-item:first-child .render-media {
      aspect-ratio: 2/1;
    }
  }
</style>
