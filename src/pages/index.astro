---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Blason from "../components/brand/Blason.astro";
import DayTimeline from "../components/sections/DayTimeline.astro";
import FeatureGrid from "../components/sections/FeatureGrid.astro";
import CtaFinal from "../components/CtaFinal.astro";
import SuiteCard from "../components/suites/SuiteCard.astro";
import { site } from "../data/site";
import {
  homeSeo,
  hero,
  maison,
  suitesTeaser,
  sejour,
  experienceTeaser,
  galerie,
  ctaFinal,
} from "../data/home";

const suites = (await getCollection("suites")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={homeSeo.title} description={homeSeo.description}>
  <!-- ===================== HERO (composition flyer) ===================== -->
  <header class="fhero">
    <div class="fhero__bg">
      <Image
        src={hero.image.src}
        alt={hero.image.alt}
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="fhero__frame" aria-hidden="true">
      <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
    </div>
    <div class="fhero__in wrap">
      <p class="fhero__eyebrow">{hero.eyebrow}</p>
      <Blason variant="or" width={168} loading="eager" class="fhero__crest" />
      <h1 class="fhero__title">{hero.title}</h1>
      <p class="fhero__signature">{hero.signature}</p>
      <p class="fhero__accroche">{hero.accroche}</p>
      <p class="fhero__descriptor">{hero.descriptor}</p>
      <div class="fhero__ornament" aria-hidden="true">✦</div>
      <p class="fhero__opening">{site.opening.label}</p>
      <div class="fhero__cta">
        <Button href="/les-suites" variant="gold-light">Découvrir les suites</Button>
        <Button href="/contact" variant="ghost-light">Être informé de l'ouverture</Button>
      </div>
    </div>
  </header>

  <!-- ===================== UNE MAISON, PAS UN DÉCOR ===================== -->
  <section class="sec maison">
    <div class="wrap">
      <div class="maison__grid">
        <div class="maison__text">
          <p class="eyebrow"><span class="ln"></span>{maison.eyebrow}</p>
          <h2 class="display-l">{maison.title[0]}<em class="gold">{maison.title[1]}</em></h2>
          {maison.paragraphs.map((p) => <p class="lede-body">{p}</p>)}
        </div>
        <div class="maison__figure">
          <Image
            src={maison.image.src}
            alt={maison.image.alt}
            widths={[500, 800, 1100]}
            sizes="(min-width:960px) 45vw, 100vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== DEUX SUITES ===================== -->
  <section class="sec suites-teaser">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow"><span class="ln"></span>{suitesTeaser.eyebrow}</p>
        <h2 class="display-l">{suitesTeaser.title[0]}<em class="gold">{suitesTeaser.title[1]}</em></h2>
        <p class="lede">{suitesTeaser.text}</p>
      </div>
      <div class="suites-grid">
        {
          suites.map((s) => (
            <SuiteCard
              href={`/${s.id}`}
              image={s.data.cardImage}
              imagePosition={s.data.cardPosition}
              name={s.data.name}
              title={s.data.nav}
              tagline={s.data.tagline}
              ambiance={s.data.ambiance}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== UN SÉJOUR ===================== -->
  <DayTimeline
    eyebrow={sejour.eyebrow}
    titleLead={sejour.title[0]}
    titleGold={sejour.title[1]}
    items={sejour.steps}
  />

  <!-- ===================== EXPÉRIENCE (teaser) ===================== -->
  <FeatureGrid
    eyebrow={experienceTeaser.eyebrow}
    titleLead={experienceTeaser.title[0]}
    titleGold={experienceTeaser.title[1]}
    background="parch-2"
    items={experienceTeaser.items}
  />
  <div class="sec exp-cta-wrap">
    <div class="wrap" style="text-align:center;">
      <Button href={experienceTeaser.href} variant="ghost">{experienceTeaser.cta}</Button>
    </div>
  </div>

  <!-- ===================== GALERIE (teaser nuit) ===================== -->
  <section class="galerie" id="galerie">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow on-dark"><span class="ln"></span>{galerie.eyebrow}</p>
        <h2 class="display-l">{galerie.title[0]}<em class="gold light">{galerie.title[1]}</em></h2>
      </div>
      <div class="gal-strip">
        {
          galerie.strip.map((img) => (
            <a href="/galerie" class={img.wide ? "wide" : undefined}>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[300, 500, 800]}
                sizes="(min-width:680px) 25vw, 50vw"
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
      <div class="gal-foot">
        <Button href={galerie.href} variant="ghost-light">{galerie.cta}</Button>
      </div>
    </div>
  </section>

  <!-- ===================== CTA FINAL ===================== -->
  <CtaFinal
    eyebrow={ctaFinal.eyebrow}
    titleLead={ctaFinal.title[0]}
    titleGold={ctaFinal.title[1]}
    text={ctaFinal.text}
    actions={ctaFinal.actions}
  />
</BaseLayout>

<style>
  /* ============ HERO FLYER ============ */
  .fhero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--creme);
    overflow: hidden;
    background: var(--noir);
    padding: 118px 0 72px;
  }
  .fhero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .fhero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fhero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 40%, rgba(20, 31, 38, 0.35), transparent 70%),
      linear-gradient(180deg, rgba(20, 31, 38, 0.82) 0%, rgba(20, 31, 38, 0.62) 45%, rgba(20, 31, 38, 0.9) 100%);
  }
  .fhero__frame {
    position: absolute;
    inset: clamp(14px, 2.6vw, 32px);
    z-index: 2;
    pointer-events: none;
  }
  .fhero__frame .c {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 0 solid rgba(200, 164, 91, 0.5);
  }
  .fhero__frame .tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .fhero__frame .tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .fhero__frame .bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .fhero__frame .br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }

  .fhero__in {
    position: relative;
    z-index: 3;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .fhero__eyebrow {
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.4em;
    font-size: 12px;
    color: var(--or);
    margin: 0 0 26px;
  }
  .fhero__crest {
    height: clamp(120px, 17vw, 168px);
    width: auto;
    margin-bottom: 24px;
    filter: drop-shadow(0 6px 26px rgba(0, 0, 0, 0.5));
  }
  .fhero__title {
    font-family: var(--display);
    font-weight: 500;
    color: var(--creme);
    font-size: clamp(40px, 8vw, 84px);
    line-height: 1;
    margin: 0;
  }
  .fhero__signature {
    font-family: var(--display);
    font-style: italic;
    color: var(--or-clair);
    font-size: clamp(26px, 5vw, 52px);
    line-height: 1.05;
    margin: 4px 0 0;
  }
  .fhero__accroche {
    font-family: var(--display);
    font-style: italic;
    color: var(--creme);
    font-size: clamp(17px, 2.4vw, 23px);
    margin: 26px 0 0;
  }
  .fhero__descriptor {
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 11px;
    color: var(--creme-dim);
    margin: 16px 0 0;
  }
  .fhero__ornament {
    color: var(--or);
    font-size: 16px;
    margin: 26px 0;
    opacity: 0.85;
  }
  .fhero__opening {
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 12.5px;
    color: var(--or-clair);
    margin: 0 0 30px;
  }
  .fhero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  /* ============ MAISON ============ */
  .maison {
    background: var(--parch);
  }
  .maison__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .maison__text .lede-body {
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.75;
    color: var(--encre-soft);
    margin: 0 0 1em;
  }
  .maison__text h2 {
    margin: 18px 0 24px;
  }
  .maison__figure {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    border: 1px solid var(--rule-l-faint);
  }
  .maison__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 960px) {
    .maison__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }

  /* ============ SUITES TEASER ============ */
  .suites-teaser {
    background: var(--parch);
  }
  .suites-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
    margin-top: 46px;
  }
  @media (min-width: 820px) {
    .suites-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .exp-cta-wrap {
    background: var(--parch-2);
    padding: 0 0 clamp(56px, 8vw, 90px);
    margin-top: -1px;
  }

  /* ============ GALERIE TEASER (nuit) ============ */
  .galerie {
    background: var(--noir);
    color: var(--creme);
    padding: clamp(64px, 9vw, 110px) 0;
  }
  .galerie .sec-head h2 {
    color: var(--creme);
  }
  .gal-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 42px;
  }
  .gal-strip a {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1/1;
    display: block;
  }
  .gal-strip a :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .gal-strip a:hover :global(img) {
    transform: scale(1.06);
  }
  .gal-strip a.wide {
    grid-column: span 2;
    aspect-ratio: 2/1;
  }
  .galerie .gal-foot {
    margin-top: 34px;
    display: flex;
    justify-content: center;
  }
  @media (min-width: 680px) {
    .gal-strip {
      grid-template-columns: repeat(4, 1fr);
    }
    .gal-strip a.wide {
      grid-column: span 2;
      aspect-ratio: auto;
    }
  }
</style>
