---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Blason from "../components/brand/Blason.astro";
import ProjectionBadge from "../components/ProjectionBadge.astro";
import DayTimeline from "../components/sections/DayTimeline.astro";
import FeatureGrid from "../components/sections/FeatureGrid.astro";
import CtaFinal from "../components/CtaFinal.astro";
import SuiteCard from "../components/suites/SuiteCard.astro";
import BeforeStay from "../components/BeforeStay.astro";
import { site } from "../data/site";
import {
  homeSeo,
  hero,
  maison,
  suitesTeaser,
  sejour,
  experienceTeaser,
  galerie,
  signatureExperience,
  histoireTeaser,
  ctaFinal,
} from "../data/home";
import { tarifs } from "../data/tarifs";
import { withBase } from "../utils/url";

const suites = (await getCollection("suites")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={homeSeo.title} description={homeSeo.description}>
  <!-- ===================== HERO (composition flyer) ===================== -->
  <header class="fhero">
    <div class="fhero__bg">
      <Image
        src={hero.image.src}
        alt={hero.image.alt}
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="fhero__frame" aria-hidden="true">
      <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
    </div>
    <div class="fhero__in wrap">
      <p class="fhero__eyebrow">{hero.eyebrow}</p>
      <Blason variant="or" width={168} loading="eager" class="fhero__crest" />
      <h1 class="fhero__title">{hero.title}</h1>
      <p class="fhero__signature">{hero.signature}</p>
      <p class="fhero__accroche">{hero.accroche}</p>
      <p class="fhero__descriptor">{hero.descriptor}</p>
      <div class="fhero__ornament" aria-hidden="true">✦</div>
      <p class="fhero__opening">{site.opening.label}</p>
      <div class="fhero__cta">
        <Button href="/liste-attente" variant="gold-light">Rejoindre la liste d’attente</Button>
        <Button href="/demo/reservation" variant="ghost-light">Découvrir le parcours</Button>
      </div>
      <p class="fhero__demo-note">Les réservations ne sont pas encore ouvertes · parcours numérique en démonstration</p>
      <div class="fhero__proofs" aria-label="Les signatures de l'expérience">
        <span><strong>2</strong> suites intimistes</span>
        <span><strong>2</strong> rituels bien-être réservés</span>
        <span><strong>1 ha</strong> de parc clos</span>
        <span><strong>1</strong> planche du territoire</span>
      </div>
    </div>
    <p class="fhero__projection">Projection de l'expérience après travaux</p>
  </header>

  <!-- ===================== UNE MAISON, PAS UN DÉCOR ===================== -->
  <section class="sec maison">
    <div class="wrap">
      <div class="maison__grid">
        <div class="maison__text">
          <p class="eyebrow"><span class="ln"></span>{maison.eyebrow}</p>
          <h2 class="display-l">{maison.title[0]}<em class="gold">{maison.title[1]}</em></h2>
          {maison.paragraphs.map((p) => <p class="lede-body">{p}</p>)}
        </div>
        <div class="maison__figure">
          <Image
            src={maison.image.src}
            alt={maison.image.alt}
            widths={[500, 800, 1100]}
            sizes="(min-width:960px) 45vw, 100vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== DEUX SUITES ===================== -->
  <section class="sec suites-teaser">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow"><span class="ln"></span>{suitesTeaser.eyebrow}</p>
        <h2 class="display-l">{suitesTeaser.title[0]}<em class="gold">{suitesTeaser.title[1]}</em></h2>
        <p class="lede">{suitesTeaser.text}</p>
      </div>
      <div class="suites-grid">
        {
          suites.map((s) => (
            <SuiteCard
              href={`/${s.id}`}
              image={s.data.cardImage}
              imagePosition={s.data.cardPosition}
              name={s.data.name}
              title={s.data.nav}
              tagline={s.data.tagline}
              ambiance={s.data.ambiance}
            />
          ))
        }
      </div>
      <div class="suite-promise">
        <span class="suite-promise__price">180–220 €</span>
        <span class="suite-promise__copy">la suite entière pour deux · petit-déjeuner, parc et piscine inclus</span>
        <a class="link-or" href={withBase("/les-suites")}>Voir les suites <span class="arr">→</span></a>
      </div>
    </div>
  </section>

  <!-- ===================== UN SÉJOUR ===================== -->
  <DayTimeline
    eyebrow={sejour.eyebrow}
    titleLead={sejour.title[0]}
    titleGold={sejour.title[1]}
    items={sejour.steps}
  />

  <!-- ===================== EXPÉRIENCE SIGNATURE ===================== -->
  <section class="sec signature-exp night">
    <div class="wrap">
      <div class="signature-exp__head">
        <p class="eyebrow on-dark"><span class="ln"></span>{signatureExperience.eyebrow}</p>
        <h2 class="display-l">{signatureExperience.title[0]}<em class="gold light">{signatureExperience.title[1]}</em></h2>
        <p class="lede">{signatureExperience.text}</p>
      </div>
      <div class="experience-film">
        {
          signatureExperience.items.map((item) => (
            <a class={`film-card${"wide" in item && item.wide ? " film-card--wide" : ""}`} href={withBase("/experience")}>
              <Image
                src={item.image.src}
                alt={item.image.alt}
                widths={[420, 720, 1100]}
                sizes={"wide" in item && item.wide ? "(min-width:820px) 66vw, 100vw" : "(min-width:820px) 33vw, 100vw"}
                loading="lazy"
              />
              <ProjectionBadge />
              <span class="film-card__veil"></span>
              <span class="film-card__copy">
                <span class="film-card__moment">{item.moment}</span>
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </span>
            </a>
          ))
        }
      </div>
      <p class="projection-legend">Ces projections traduisent l'intention d'aménagement après travaux. Les photographies définitives seront réalisées en mars 2027.</p>
      <div class="signature-exp__cta"><Button href="/experience" variant="ghost-light">Vivre l'expérience en détail</Button></div>
    </div>
  </section>

  <!-- ===================== EXPÉRIENCE (teaser) ===================== -->
  <FeatureGrid
    eyebrow={experienceTeaser.eyebrow}
    titleLead={experienceTeaser.title[0]}
    titleGold={experienceTeaser.title[1]}
    background="parch-2"
    items={experienceTeaser.items}
  />
  <div class="sec exp-cta-wrap">
    <div class="wrap" style="text-align:center;">
      <Button href={experienceTeaser.href} variant="ghost">{experienceTeaser.cta}</Button>
    </div>
  </div>

  <!-- ===================== GALERIE (teaser nuit) ===================== -->
  <section class="galerie" id="galerie">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow on-dark"><span class="ln"></span>{galerie.eyebrow}</p>
        <h2 class="display-l">{galerie.title[0]}<em class="gold light">{galerie.title[1]}</em></h2>
      </div>
      <div class="gal-strip">
        {
          galerie.strip.map((img) => (
            <a href={withBase("/galerie")} class={img.wide ? "wide" : undefined}>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[300, 500, 800]}
                sizes="(min-width:680px) 25vw, 50vw"
                loading="lazy"
              />
              {img.projection && <ProjectionBadge />}
            </a>
          ))
        }
      </div>
      <div class="gal-foot">
        <Button href={galerie.href} variant="ghost-light">{galerie.cta}</Button>
      </div>
    </div>
  </section>

  <!-- ===================== HISTOIRE ===================== -->
  <section class="sec story-door">
    <div class="wrap story-door__grid">
      <div class="story-door__image">
        <Image
          src={histoireTeaser.image.src}
          alt={histoireTeaser.image.alt}
          widths={[500, 800, 1200]}
          sizes="(min-width:880px) 50vw, 100vw"
          loading="lazy"
        />
      </div>
      <div class="story-door__body">
        <p class="eyebrow"><span class="ln"></span>{histoireTeaser.eyebrow}</p>
        <h2 class="display-l">{histoireTeaser.title[0]}<em class="gold">{histoireTeaser.title[1]}</em></h2>
        <p class="lede">{histoireTeaser.text}</p>
        <Button href={histoireTeaser.href} variant="ghost">Entrer dans l'histoire</Button>
      </div>
    </div>
  </section>

  <BeforeStay />

  <!-- ===================== TARIFS ===================== -->
  <section class="sec home-rates">
    <div class="wrap">
      <div class="home-rates__intro">
        <p class="eyebrow"><span class="ln"></span>{tarifs.eyebrow}</p>
        <h2 class="display-l">{tarifs.title[0]}<em class="gold">{tarifs.title[1]}</em></h2>
        <p class="lede">{tarifs.intro}</p>
        <p class="home-rates__family">{tarifs.family}</p>
      </div>
      <div class="home-rates__grid">
        {tarifs.items.map((item) => (
          <article class="rate-card">
            <p class="rate-card__label">{item.label}</p>
            <p class="rate-card__value">{item.value}<span>{item.unit}</span></p>
            <p class="rate-card__note">{item.note}</p>
          </article>
        ))}
      </div>
      <p class="note home-rates__note">{tarifs.note} <a href={withBase("/conditions-sejour")}>Lire les conditions prévisionnelles.</a></p>
      <div class="home-rates__cta">
        <Button href="/liste-attente" variant="solid">Rejoindre la liste d’attente</Button>
        <Button href="/demo/reservation" variant="ghost">Tester la formule</Button>
      </div>
    </div>
  </section>

  <!-- ===================== CTA FINAL ===================== -->
  <CtaFinal
    eyebrow={ctaFinal.eyebrow}
    titleLead={ctaFinal.title[0]}
    titleGold={ctaFinal.title[1]}
    text={ctaFinal.text}
    actions={ctaFinal.actions}
  />
</BaseLayout>

<style>
  /* ============ HERO FLYER ============ */
  .fhero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--creme);
    overflow: hidden;
    background: var(--noir);
    padding: 118px 0 72px;
  }
  .fhero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .fhero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fhero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 40%, rgba(20, 31, 38, 0.35), transparent 70%),
      linear-gradient(180deg, rgba(20, 31, 38, 0.82) 0%, rgba(20, 31, 38, 0.62) 45%, rgba(20, 31, 38, 0.9) 100%);
  }
  .fhero__frame {
    position: absolute;
    inset: clamp(14px, 2.6vw, 32px);
    z-index: 2;
    pointer-events: none;
  }
  .fhero__frame .c {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 0 solid rgba(200, 164, 91, 0.5);
  }
  .fhero__frame .tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .fhero__frame .tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .fhero__frame .bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .fhero__frame .br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }

  .fhero__in {
    position: relative;
    z-index: 3;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .fhero__eyebrow {
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.4em;
    font-size: 12px;
    color: var(--or);
    margin: 0 0 26px;
  }
  .fhero__crest {
    height: clamp(120px, 17vw, 168px);
    width: auto;
    margin-bottom: 24px;
    filter: drop-shadow(0 6px 26px rgba(0, 0, 0, 0.5));
  }
  .fhero__title {
    font-family: var(--display);
    font-weight: 500;
    color: var(--creme);
    font-size: clamp(40px, 8vw, 84px);
    line-height: 1;
    margin: 0;
  }
  .fhero__signature {
    font-family: var(--display);
    font-style: italic;
    color: var(--or-clair);
    font-size: clamp(26px, 5vw, 52px);
    line-height: 1.05;
    margin: 4px 0 0;
  }
  .fhero__accroche {
    font-family: var(--display);
    font-style: italic;
    color: var(--creme);
    font-size: clamp(17px, 2.4vw, 23px);
    margin: 26px 0 0;
  }
  .fhero__descriptor {
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 11px;
    color: var(--creme-dim);
    margin: 16px 0 0;
  }
  .fhero__ornament {
    color: var(--or);
    font-size: 16px;
    margin: 26px 0;
    opacity: 0.85;
  }
  .fhero__opening {
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 12.5px;
    color: var(--or-clair);
    margin: 0 0 30px;
  }
  .fhero__projection {
    position: absolute;
    z-index: 4;
    right: clamp(18px, 3vw, 44px);
    bottom: clamp(18px, 3vw, 34px);
    margin: 0;
    font-family: var(--serif);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 9px;
    color: rgba(242, 235, 221, 0.76);
  }
  @media (max-width: 679px) {
    .fhero__projection {
      bottom: 76px;
      max-width: 22ch;
      text-align: right;
    }
  }
  .fhero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
  .fhero__demo-note {
    margin: 12px 0 0;
    color: rgba(242, 235, 221, 0.7);
    font-size: 11px;
    font-style: italic;
  }
  .fhero__proofs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 650px);
    margin-top: 30px;
    border-top: 1px solid rgba(200, 164, 91, 0.28);
    border-bottom: 1px solid rgba(200, 164, 91, 0.28);
  }
  .fhero__proofs span {
    padding: 13px 10px;
    color: var(--creme-dim);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .fhero__proofs strong {
    display: block;
    font-family: var(--display);
    color: var(--or-clair);
    font-size: 24px;
    font-weight: 500;
    line-height: 1;
  }
  @media (min-width: 680px) {
    .fhero__proofs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* ============ MAISON ============ */
  .maison {
    background: var(--parch);
  }
  .maison__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .maison__text .lede-body {
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.75;
    color: var(--encre-soft);
    margin: 0 0 1em;
  }
  .maison__text h2 {
    margin: 18px 0 24px;
  }
  .maison__figure {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    border: 1px solid var(--rule-l-faint);
  }
  .maison__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 960px) {
    .maison__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }

  /* ============ SUITES TEASER ============ */
  .suites-teaser {
    background: var(--parch);
  }
  .suites-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
    margin-top: 46px;
  }
  @media (min-width: 820px) {
    .suites-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .suite-promise {
    margin-top: 30px;
    padding: 22px 0;
    border-top: 1px solid var(--rule-l);
    border-bottom: 1px solid var(--rule-l);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
  }
  .suite-promise__price {
    font-family: var(--display);
    font-size: clamp(32px, 4vw, 48px);
    color: var(--or-prof);
    line-height: 1;
  }
  .suite-promise__copy {
    color: var(--encre-soft);
  }
  .suite-promise .link-or {
    margin-left: auto;
  }

  /* ============ EXPÉRIENCE SIGNATURE ============ */
  .signature-exp {
    background: var(--noir);
    color: var(--creme);
  }
  .signature-exp__head {
    max-width: 760px;
  }
  .signature-exp__head h2 {
    margin: 18px 0;
    color: var(--creme);
  }
  .signature-exp__head .lede {
    color: var(--creme-dim);
  }
  .experience-film {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 46px;
  }
  .film-card {
    position: relative;
    min-height: 390px;
    overflow: hidden;
    border: 1px solid var(--rule-d-faint);
  }
  .film-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    transition: transform 0.8s ease;
  }
  .film-card:hover :global(img) {
    transform: scale(1.035);
  }
  .film-card__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 25%, rgba(8, 14, 18, 0.88));
  }
  .film-card__copy {
    position: absolute;
    z-index: 3;
    left: 24px;
    right: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
  }
  .film-card__moment {
    color: var(--or-clair);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    margin-bottom: 7px;
  }
  .film-card__copy strong {
    font-family: var(--display);
    font-size: clamp(25px, 3vw, 34px);
    font-weight: 500;
    line-height: 1.05;
  }
  .film-card__copy > span:last-child {
    color: var(--creme-dim);
    font-size: 15px;
    line-height: 1.45;
    margin-top: 8px;
  }
  .projection-legend {
    max-width: 760px;
    margin: 24px 0 0;
    color: var(--creme-faint);
    font-size: 12.5px;
    font-style: italic;
  }
  .signature-exp__cta {
    margin-top: 28px;
  }
  @media (min-width: 820px) {
    .experience-film {
      grid-template-columns: repeat(6, 1fr);
    }
    .film-card {
      grid-column: span 2;
      min-height: 430px;
    }
    .film-card--wide {
      grid-column: span 4;
    }
  }

  .exp-cta-wrap {
    background: var(--parch-2);
    padding: 0 0 clamp(56px, 8vw, 90px);
    margin-top: -1px;
  }

  /* ============ GALERIE TEASER (nuit) ============ */
  .galerie {
    background: var(--noir);
    color: var(--creme);
    padding: clamp(64px, 9vw, 110px) 0;
  }
  .galerie .sec-head h2 {
    color: var(--creme);
  }
  .gal-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 42px;
  }
  .gal-strip a {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1/1;
    display: block;
  }
  .gal-strip a :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .gal-strip a:hover :global(img) {
    transform: scale(1.06);
  }
  .gal-strip a.wide {
    grid-column: span 2;
    aspect-ratio: 2/1;
  }
  .galerie .gal-foot {
    margin-top: 34px;
    display: flex;
    justify-content: center;
  }

  /* ============ PORTE DE L'HISTOIRE ============ */
  .story-door {
    background: var(--parch);
  }
  .story-door__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .story-door__image {
    min-height: 430px;
    overflow: hidden;
    border: 1px solid var(--rule-l-faint);
  }
  .story-door__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(.16) contrast(.96);
  }
  .story-door__body h2 {
    margin: 18px 0 20px;
  }
  .story-door__body .lede {
    margin-bottom: 28px;
  }
  @media (min-width: 880px) {
    .story-door__grid {
      grid-template-columns: .95fr 1.05fr;
      gap: 64px;
    }
  }

  /* ============ TARIFS ============ */
  .home-rates {
    background: var(--parch-2);
  }
  .home-rates__intro {
    max-width: 780px;
  }
  .home-rates__intro h2 {
    margin: 18px 0;
  }
  .home-rates__family {
    margin-top: 20px;
    padding-left: 18px;
    border-left: 2px solid var(--or-prof);
    color: var(--encre-soft);
  }
  .home-rates__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--rule-l-faint);
    border: 1px solid var(--rule-l-faint);
    margin-top: 42px;
  }
  .rate-card {
    background: var(--parch-card);
    padding: 30px;
  }
  .rate-card p { margin: 0; }
  .rate-card__label {
    color: var(--encre-soft);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: .14em;
  }
  .rate-card__value {
    font-family: var(--display);
    color: var(--or-prof);
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1;
