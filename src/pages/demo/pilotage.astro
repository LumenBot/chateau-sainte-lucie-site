---
import { Image } from "astro:assets";
import DemoLayout from "../../layouts/DemoLayout.astro";
import { withBase } from "../../utils/url";
import "../../styles/pilotage.css";
import parc from "../../assets/images/projection/parc-depuis-perron-soir.jpeg";
import chemin from "../../assets/images/projection/chemin-bain-nordique-soir.jpeg";
---

<DemoLayout
  title="Base de vérité du projet — Les Nuits au Château"
  description="Base de connaissance, simulateur économique, benchmark, investissements et plan directeur des Suites de Sainte-Lucie."
  section="pilotage"
>
  <div class="demo-shell pilotage-v2">
    <header class="pilotage-hero">
      <div class="pilotage-hero__copy">
        <p class="demo-kicker">Base de vérité partagée · mise à jour le 9 août 2026</p>
        <h1>Comprendre le projet.<br /><em class="gold light">Décider sur les mêmes faits.</em></h1>
        <p class="lede">La photographie courante du modèle, ses sources et ses hypothèses. Chaque associé — humain ou agent IA — peut explorer les chiffres, reproduire les calculs et préparer un arbitrage argumenté.</p>
        <div class="pilotage-hero__facts">
          <span><strong>30</strong> lieux comparés</span>
          <span><strong>65 k€</strong> enveloppe travaux</span>
          <span><strong>avril 2027</strong> ouverture visée</span>
        </div>
      </div>
      <figure class="pilotage-hero__image">
        <Image src={parc} alt="Projection du parc scénographié vu depuis le perron au crépuscule" widths={[700, 1100, 1500]} sizes="(max-width: 900px) 100vw, 47vw" loading="eager" />
        <figcaption><strong>La promesse signature.</strong><span>Une demeure privée, un parc nocturne et un bien-être réservé · projection après travaux</span></figcaption>
      </figure>
    </header>

    <div class="pilotage-security" role="note">
      <strong>Partageable, non authentifié.</strong>
      <span>Les sources financières, juridiques et patrimoniales brutes restent hors ligne. Cette page publie des données dérivées, sans information personnelle sensible.</span>
    </div>

    <nav class="pilotage-tabs" role="tablist" aria-label="Rubriques de la base de vérité">
      <button class="active" type="button" role="tab" aria-selected="true" aria-controls="panel-simulateur" data-pilotage-tab="simulateur"><span>01</span>Simulateur</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-marche" data-pilotage-tab="marche"><span>02</span>Marché</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-investissements" data-pilotage-tab="investissements"><span>03</span>Investissements</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-plan" data-pilotage-tab="plan"><span>04</span>Plan directeur</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-referentiel" data-pilotage-tab="referentiel"><span>05</span>Référentiel</button>
    </nav>

    <section id="panel-simulateur" class="pilotage-panel" role="tabpanel" data-pilotage-panel="simulateur">
      <div class="pilotage-section-head">
        <div><p class="demo-kicker">Deux années, un modèle explicable</p><h2>Jouer sur l’ambition.<br />Voir immédiatement l’engagement.</h2></div>
        <div class="pilotage-actions"><button class="demo-button secondary" type="button" data-pilotage-share>Copier le scénario</button><button class="demo-button quiet" type="button" data-pilotage-reset>Réinitialiser</button></div>
      </div>

      <div class="pilotage-scenarios-v2" role="group" aria-label="Choisir un scénario de départ">
        <button class="active" type="button" data-pilotage-scenario="pilot"><span>01 · APPRENDRE</span><strong>Lancement maîtrisé</strong><small>90 → 120 nuits/suite</small></button>
        <button type="button" data-pilotage-scenario="balance"><span>02 · CONSOLIDER</span><strong>Équilibre recherché</strong><small>120 → 150 nuits/suite</small></button>
        <button type="button" data-pilotage-scenario="ambition"><span>03 · DÉMONTRER</span><strong>Premium installé</strong><small>150 → 180 nuits/suite</small></button>
        <button type="button" data-pilotage-scenario="custom"><span>04 · EXPLORER</span><strong>Scénario libre</strong><small>tous paramètres ajustables</small></button>
      </div>

      <div class="pilotage-summary-grid" aria-live="polite">
        <article class="pilotage-summary-card primary"><span>CA année 1</span><strong data-output="y1-revenue">—</strong><small data-output="y1-adr">—</small></article>
        <article class="pilotage-summary-card"><span>Résultat année 1</span><strong data-output="y1-result">—</strong><small>avant impôt, dette et amortissements</small></article>
        <article class="pilotage-summary-card"><span>CA année 2</span><strong data-output="y2-revenue">—</strong><small data-output="y2-adr">—</small></article>
        <article class="pilotage-summary-card"><span>Résultat année 2</span><strong data-output="y2-result">—</strong><small data-output="trajectory-note">—</small></article>
      </div>

      <div class="pilotage-workbench-v2">
        <form class="pilotage-controls-v2" data-pilotage-form>
          <details open>
            <summary><span>01</span>Trajectoire commerciale</summary>
            <p class="pilotage-help">Une gamme saisonnière calcule un prix moyen pondéré. Les nuits sont exprimées par suite : 120 signifie 240 nuits-suite vendues sur les deux suites.</p>
            <div class="pilotage-year-grid">
              <fieldset><legend>Année 1 · lancement</legend>
                <label class="demo-field"><span class="label">Gamme de prix</span><select name="priceProfile1"><option value="launch">180–220 € · prix moyen 198 €</option><option value="180">Prix unique 180 €</option><option value="200">Prix unique 200 €</option><option value="220">Prix unique 220 €</option><option value="240">Prix unique 240 €</option></select></label>
                <label class="demo-field"><span class="label">Nuits vendues / suite</span><select name="nights1"><option>90</option><option selected>120</option><option>150</option><option>180</option></select></label>
              </fieldset>
              <fieldset><legend>Année 2 · consolidation</legend>
                <label class="demo-field"><span class="label">Gamme de prix</span><select name="priceProfile2"><option value="year2" selected>200–240 € · prix moyen 220 €</option><option value="180">Prix unique 180 €</option><option value="200">Prix unique 200 €</option><option value="220">Prix unique 220 €</option><option value="240">Prix unique 240 €</option></select></label>
                <label class="demo-field"><span class="label">Nuits vendues / suite</span><select name="nights2"><option>90</option><option>120</option><option selected>150</option><option>180</option></select></label>
              </fieldset>
            </div>
          </details>

          <details open>
            <summary><span>02</span>Expériences et panier moyen</summary>
            <div class="demo-form-grid three">
              <label class="demo-field"><span class="label">Formule bien-être</span><select name="spaOffer"><option value="pack40">Pack unique · 40 €</option><option value="pack50" selected>Pack unique · 50 €</option><option value="pack60">Pack unique · 60 €</option><option value="catalog">Carte signature · panier moyen 74 €</option></select></label>
              <label class="demo-field"><span class="label">Séjours acheteurs spa</span><select name="spaTake"><option value="30">30 %</option><option value="45" selected>45 %</option><option value="60">60 %</option><option value="75">75 %</option></select></label>
              <label class="demo-field"><span class="label">Prix repas / personne</span><select name="mealPrice"><option>40</option><option selected>50</option><option>60</option></select></label>
              <label class="demo-field"><span class="label">Accord mets & vins</span><select name="winePrice"><option>20</option><option selected>30</option><option>40</option></select></label>
              <label class="demo-field"><span class="label">Séjours avec table</span><select name="dinnerTake"><option value="15">15 %</option><option value="30" selected>30 %</option><option value="45">45 %</option><option value="60">60 %</option></select></label>
              <label class="demo-field"><span class="label">Tables en version romantique</span><select name="romanticShare"><option value="0">0 %</option><option value="20" selected>20 %</option><option value="40">40 %</option><option value="60">60 %</option></select></label>
            </div>
            <div class="pilotage-pack-note"><strong>Carte signature simulée</strong><span>Bain nordique 45 € · sauna 35 € · duo nordique 65 € · bien-être intérieur 50 € · nuit aux lanternes 95 €. Le panier de 74 € est une moyenne de travail, pas un tarif public validé.</span></div>
          </details>

          <details>
            <summary><span>03</span>Distribution, emploi et charges</summary>
            <div class="demo-form-grid three">
              <label class="demo-field"><span class="label">Réservations directes</span><select name="directShare"><option value="40">40 %</option><option value="55" selected>55 %</option><option value="70">70 %</option></select></label>
              <label class="demo-field"><span class="label">Coût employeur du poste Jules</span><select name="salaryCost"><option value="30000">Budget limité · 30 000 €</option><option value="40500" selected>30 k€ brut · hypothèse 40 500 €</option><option value="54000">Cible proche de 30 k€ net · 54 000 €</option></select></label>
              <label class="demo-field"><span class="label">Couverture complémentaire</span><select name="supportMode"><option value="family">Associés / famille · coût non valorisé</option><option value="mixed" selected>Renfort / sous-traitance · 25 €/h</option><option value="second">Deuxième ETP · 40 500 €</option></select></label>
              <label class="demo-field"><span class="label">Loyer annuel versé à la SCI</span><input name="rent" type="number" min="0" max="60000" step="1000" value="18000" /></label>
              <label class="demo-field"><span class="label">Autres frais fixes</span><input name="otherFixed" type="number" min="0" max="60000" step="1000" value="8000" /></label>
              <label class="demo-field"><span class="label">Investissement initial</span><input name="capex" type="number" min="0" max="200000" step="1000" value="65000" /></label>
            </div>
            <p class="pilotage-help">Le coût de 40 500 € est une hypothèse centrale de simulation pour 30 000 € brut annuel. Le coût réel dépendra du contrat, de la convention collective, des allègements et avantages : il devra être remplacé par une simulation Urssaf et une proposition de paie.</p>
          </details>
        </form>

        <aside class="pilotage-live-results" aria-live="polite">
          <p class="demo-kicker">Lecture du scénario</p>
          <h3 data-output="scenario-name">Équilibre recherché</h3>
          <div class="pilotage-big-result"><span>Résultat année 2</span><strong data-output="y2-result">—</strong></div>
          <div class="pilotage-result-row"><span>CA total</span><strong data-output="y2-revenue">—</strong></div>
          <div class="pilotage-result-row"><span>Part expériences</span><strong data-output="y2-experience-share">—</strong></div>
          <div class="pilotage-result-row"><span>Seuil d’équilibre</span><strong data-output="break-even">—</strong></div>
          <div class="pilotage-result-row"><span>Charge annuelle</span><strong data-output="y2-hours">—</strong></div>
          <div class="pilotage-result-row"><span>Renfort structurel</span><strong data-output="y2-support">—</strong></div>
          <div class="pilotage-result-row"><span>Retour simple du CAPEX</span><strong data-output="payback">—</strong></div>
          <div class="pilotage-verdict" data-verdict></div>
          <p class="pilotage-footnote">Résultat d’exploitation simplifié avant impôt, TVA, dette et amortissements. Il ne constitue ni un prévisionnel comptable ni une validation sociale.</p>
        </aside>
      </div>

      <div class="pilotage-section-head compact"><div><p class="demo-kicker">Compte de résultat explicable</p><h2>D’où vient chaque euro.</h2></div><p>Année 1 et année 2 sont calculées avec la même structure de coûts. Les lignes peuvent être retrouvées dans le référentiel machine.</p></div>
      <div class="pilotage-pnl" data-pnl></div>

      <div class="pilotage-capacity-grid">
        <article><p class="demo-kicker">Un salarié suffit-il ?</p><h3 data-output="staffing-title">—</h3><p data-output="staffing-copy">—</p></article>
        <article><p class="demo-kicker">Temps des associés</p><h3 data-output="family-hours">—</h3><p>Sans budget de renfort, ce volume devient une contribution familiale à organiser explicitement : week-ends, congés, urgences et continuité de service.</p></article>
        <article><p class="demo-kicker">Conclusion de pilotage</p><h3>Un ETP + un dispositif de relève.</h3><p>Le premier recrutement peut porter l’exploitation quotidienne. Il ne peut pas garantir seul 7 jours sur 7 l’accueil, la table, le parc, les absences et les pics. Le renfort doit être budgété ou attribué.</p></article>
      </div>

      <div class="pilotage-insights">
        <details open><summary>Formules économiques</summary><p>CA hébergement = 2 suites × nuits vendues × prix moyen. Les séjours sont déduits d’une durée moyenne de 2,1 nuits. Commissions, remise en état, petit-déjeuner, énergie, coûts spa et table sont retirés avant le loyer SCI, l’emploi et les autres charges fixes.</p></details>
        <details><summary>Modèle de temps</summary><p>Hypothèse : 3 h par rotation, 0,65 h par nuit-suite pour le petit-déjeuner, 1 h par séjour pour accueil/administration, 0,75 h par réservation spa, 4,5 h par table, 420 h/an de parc et 300 h/an d’administration/maintenance. Capacité utile de pilotage : 1 350 h sur les 1 607 h légales, afin de conserver une réserve.</p></details>
        <details><summary>Ce qu’il faut chronométrer</summary><p>Trois séjours à blanc en mars 2027 devront mesurer ménage, petit-déjeuner, accueil, entretien spa, préparation de table et déplacements. Ces mesures remplaceront les hypothèses de travail avant l’ouverture.</p></details>
      </div>
    </section>

    <section id="panel-marche" class="pilotage-panel" role="tabpanel" data-pilotage-panel="marche" hidden>
      <div class="pilotage-section-head"><div><p class="demo-kicker">Benchmark de 30 lieux</p><h2>Le patrimoine seul ne crée pas le premium.</h2></div><p>Les prix sont indicatifs, observés à des dates et sur des canaux différents. Ils donnent des ordres de grandeur et des modèles de valeur, pas un tarif garanti.</p></div>
      <div class="pilotage-market-kpis"><article><span>Médiane Vosges</span><strong>206 €</strong><small>10 références</small></article><article><span>Médiane France</span><strong>213 €</strong><small>20 références</small></article><article><span>Médiane globale</span><strong>210 €</strong><small>30 références</small></article><article><span>Cible à maturité</span><strong>220–240 €</strong><small>si l’exécution le démontre</small></article></div>
      <div class="pilotage-market-tools"><label class="demo-field"><span class="label">Périmètre</span><select data-market-scope><option value="vosges">Vosges · 10 lieux</option><option value="france">France · 20 lieux</option><option value="all">Ensemble · 30 lieux</option></select></label><label class="demo-field"><span class="label">Examiner un lieu</span><select data-competitor-select></select></label></div>
      <div class="pilotage-market-layout"><div class="pilotage-chart" data-market-chart aria-label="Comparaison des prix indicatifs"></div><article class="pilotage-competitor-detail" data-competitor-detail></article></div>
      <div class="pilotage-section-head compact"><div><p class="demo-kicker">Raisonnement reproductible</p><h2>De l’observation à la recommandation.</h2></div></div>
      <div class="pilotage-insights">
        <details open><summary>Conclusion</summary><p>Ouvrir avec une gamme 180–220 € limite le risque sans enfermer la marque dans un prix bas. Après photographies réelles, avis et preuve du service, la gamme 200–240 € devient défendable. Les dates fortes pourront dépasser cette cible.</p></details>
        <details><summary>Les cinq références centrales</summary><p>Failloux valide la demande locale ; Landin associe patrimoine et bien-être ; Château Réal travaille l’ancrage territorial ; Maison Durieux prouve le premium hors grande destination ; Château Duo monétise de grandes suites et un spa privatif.</p></details>
        <details><summary>Chaîne de valeur retenue</summary><p>1. Volumes réels d’une suite. 2. Finition des salles de bain. 3. Parc nocturne. 4. Créneaux bien-être réservés. 5. Table incarnée. 6. Vente directe. Le prix n’est que la conséquence de cette exécution.</p></details>
        <details><summary>Limites de la donnée</summary><p>Échantillon construit pour éclairer le positionnement, non statistiquement représentatif. Les prix doivent être revérifiés sur les mêmes dates, pour deux personnes, avec conditions et prestations comparables avant la grille 2027.</p></details>
      </div>
    </section>

    <section id="panel-investissements" class="pilotage-panel" role="tabpanel" data-pilotage-panel="investissements" hidden>
      <div class="pilotage-section-head"><div><p class="demo-kicker">Budget Jules · fournitures et équipements</p><h2>61–64 k€ documentés.<br />65 k€ à sécuriser.</h2></div><p>Main-d’œuvre familiale non valorisée. Les devis, aléas de chantier et besoin en fonds de roulement restent à ajouter au plan de financement final.</p></div>
      <div class="pilotage-budget-overview"><article class="pilotage-budget-total"><span>Enveloppe de travail</span><strong>65 000 € TTC</strong><div><i style="width:60.8%"></i><i style="width:35.4%"></i><i style="width:3.8%"></i></div><small>Intérieur 39,5 k€ · extérieur 21,5–24,5 k€ · marge résiduelle</small></article><article><span>Ancienne base remplacée</span><strong>50 000 €</strong><p>Ne plus l’utiliser pour le financement.</p></article><article><span>Variable principale</span><strong>Éclairage</strong><p>7,5 à 10,5 k€ selon le système retenu.</p></article></div>
      <div class="pilotage-budget-grid"><article><span>Suites</span><strong>12 000 €</strong><i style="--share:18.5%"></i><small>Mobilier, literie, textiles, miroirs, décoration</small></article><article><span>Salles de bain</span><strong>21 500 €</strong><i style="--share:33.1%"></i><small>Grande 15 k€ + petite 6,5 k€</small></article><article><span>Terrasses & décoration</span><strong>6 000 €</strong><i style="--share:9.2%"></i><small>Deux terrasses et finitions complémentaires</small></article><article><span>Allée & réseaux</span><strong>4 000 €</strong><i style="--share:6.2%"></i><small>Cheminement 2,5 k€ + réseaux 1,5 k€</small></article><article><span>Éclairage extérieur</span><strong>7 500–10 500 €</strong><i style="--share:13.8%"></i><small>Bornes, câblage, gaines et pose technique</small></article><article><span>Bain & sauna</span><strong>10 000 €</strong><i style="--share:15.4%"></i><small>Bain nordique 4 k€ + sauna 6 k€</small></article></div>
      <div class="pilotage-priority"><Image src={chemin} alt="Projection du chemin éclairé menant au bain nordique" widths={[620, 1000]} sizes="(max-width:900px) 100vw, 50vw" /><div><p class="demo-kicker">Ordre de priorité</p><h3>Investir là où le client voit la différence.</h3><ol><li>Étanchéité, sécurité, salles de bain et réseaux.</li><li>Literie, textiles et qualité d’usage des suites.</li><li>Éclairage du parc et cheminement signature.</li><li>Bain nordique et sauna intégrés au paysage.</li><li>Décoration additionnelle après arbitrage de la marge.</li></ol></div></div>
      <div class="pilotage-insights"><details open><summary>Ce que couvre le budget</summary><p>Fournitures et équipements listés par Jules pour les deux suites, salles de bain, terrasses, parc et spa extérieur. La fourchette corrigée constitue la base active.</p></details><details><summary>Ce qu’il ne couvre pas encore</summary><p>Valorisation du travail familial, trésorerie de démarrage, coûts juridiques et numériques, assurances, photographie finale, consommables d’ouverture, imprévus et éventuels travaux réglementaires.</p></details><details><summary>Règle de mise à jour</summary><p>Chaque poste devra passer de « estimation » à « devis », puis « commandé » et « payé ». Le budget initial et l’atterrissage doivent rester séparés pour mesurer les écarts.</p></details></div>
    </section>

    <section id="panel-plan" class="pilotage-panel" role="tabpanel" data-pilotage-panel="plan" hidden>
      <div class="pilotage-section-head"><div><p class="demo-kicker">Septembre 2026 → avril 2027</p><h2>Le chemin critique de l’ouverture.</h2></div><div class="pilotage-progress-copy"><strong data-roadmap-progress>0 %</strong><span>avancement enregistré dans ce navigateur</span></div></div>
      <div class="pilotage-progress"><i data-roadmap-progress-bar></i></div>
      <div class="pilotage-roadmap-v2">
        <details open><summary><span>SEPT.–OCT.</span><strong>Verrouiller le cadre</strong><em class="demo-status urgent">Critique</em></summary><p>Le montage, les responsabilités et la sécurité conditionnent tous les contrats suivants.</p><label><input type="checkbox" data-roadmap-task="company" /> Choisir la société d’exploitation et son régime fiscal</label><label><input type="checkbox" data-roadmap-task="lease" /> Formaliser bail SCI / société et allocation des travaux</label><label><input type="checkbox" data-roadmap-task="townhall" /> Déclarations mairie, classement ERP et taxe de séjour</label><label><input type="checkbox" data-roadmap-task="ars" /> Sécuriser piscine naturelle et équipements bien-être</label><label><input type="checkbox" data-roadmap-task="food" /> Qualifier table, hygiène, allergènes et licences boissons</label><label><input type="checkbox" data-roadmap-task="insurance" /> Assurances murs, travaux, exploitation et responsabilité</label></details>
        <details><summary><span>NOV.–DÉC.</span><strong>Rendre l’offre vendable</strong><em class="demo-status simulated">À préparer</em></summary><p>La communication de décembre suppose une offre vraie, des conditions lisibles et une preuve explicite du caractère projeté des images.</p><label><input type="checkbox" data-roadmap-task="pricing" /> Valider gammes saisonnières et règles de remise</label><label><input type="checkbox" data-roadmap-task="cgv" /> Finaliser CGV, annulation, caution et médiateur</label><label><input type="checkbox" data-roadmap-task="signature" /> Choisir l’expérience signature et ses coûts</label><label><input type="checkbox" data-roadmap-task="prelaunch" /> Ouvrir liste d’attente et pré-lancement</label></details>
        <details><summary><span>JANV.–FÉV.</span><strong>Construire l’exploitation</strong><em class="demo-status simulated">À préparer</em></summary><p>Outils, contrats et procédures doivent être testables sans dépendre d’une mémoire individuelle.</p><label><input type="checkbox" data-roadmap-task="pms" /> Choisir PMS/channel manager, paiement et vente directe</label><label><input type="checkbox" data-roadmap-task="employment" /> Contrat, classification, paie, planning et relève du salarié</label><label><input type="checkbox" data-roadmap-task="procedures" /> Écrire accueil, ménage, table, spa, incidents et astreinte</label><label><input type="checkbox" data-roadmap-task="accounting" /> Construire plan comptable, facturation et exports</label><label><input type="checkbox" data-roadmap-task="privacy" /> RGPD, consentements, conservation et sécurité</label><label><input type="checkbox" data-roadmap-task="continuity" /> Modes dégradés, clés, paiement et continuité</label></details>
        <details><summary><span>MARS</span><strong>Recetter en conditions réelles</strong><em class="demo-status simulated">À préparer</em></summary><p>Les essais transforment les hypothèses de temps et de coût en données d’exploitation.</p><label><input type="checkbox" data-roadmap-task="photos" /> Remplacer les projections par les photos réelles</label><label><input type="checkbox" data-roadmap-task="dryruns" /> Trois séjours à blanc : direct, OTA et incident</label><label><input type="checkbox" data-roadmap-task="timings" /> Chronométrer tous les gestes opératoires</label><label><input type="checkbox" data-roadmap-task="stock" /> Constituer stocks, contrôles et carnets d’entretien</label><label><input type="checkbox" data-roadmap-task="training" /> Former les personnes de relève</label><label><input type="checkbox" data-roadmap-task="gono" /> Go/no-go formalisé le 31 mars</label></details>
