---
import { Image } from "astro:assets";
import DemoLayout from "../../layouts/DemoLayout.astro";
import { withBase } from "../../utils/url";
import "../../styles/pilotage.css";
import parc from "../../assets/images/projection/parc-depuis-perron-soir.jpeg";
import chemin from "../../assets/images/projection/chemin-bain-nordique-soir.jpeg";
import suite from "../../assets/images/projection/feuillage-chambre.jpg";
import table from "../../assets/images/projection/table-hotes.jpg";
---

<DemoLayout
  title="Projet et modèle économique — Les Nuits au Château"
  description="Cockpit interne de simulation économique, d'analyse concurrentielle et de coordination du projet des Suites de Sainte-Lucie."
  section="pilotage"
>
  <div class="demo-shell pilotage-v2">
    <header class="pilotage-hero">
      <div class="pilotage-hero__copy">
        <p class="demo-kicker">Cockpit des associés · août 2026</p>
        <h1>Choisir l’ambition.<br /><em class="gold light">Mesurer l’engagement.</em></h1>
        <p class="lede">Une lecture commune du marché, du budget, de la capacité acceptable et du chemin vers avril 2027. Les chiffres sont modifiables ; les décisions restent à prendre ensemble.</p>
        <div class="pilotage-hero__facts">
          <span><strong>30</strong> lieux comparés</span>
          <span><strong>65 k€</strong> enveloppe travaux</span>
          <span><strong>2</strong> suites privatives</span>
        </div>
      </div>
      <figure class="pilotage-hero__image">
        <Image src={parc} alt="Projection du parc scénographié vu depuis le perron au crépuscule" widths={[700, 1100, 1500]} sizes="(max-width: 900px) 100vw, 47vw" loading="eager" />
        <figcaption><strong>Le produit signature.</strong><span>Le parc qui s’éveille à la nuit · projection après travaux</span></figcaption>
      </figure>
    </header>

    <div class="pilotage-security" role="note">
      <strong>Espace de travail non indexé, mais non authentifié.</strong>
      <span>Le lien peut être partagé entre associés. Ne pas y inscrire de données bancaires, personnelles ou patrimoniales sensibles.</span>
    </div>

    <nav class="pilotage-tabs" role="tablist" aria-label="Rubriques du cockpit stratégique">
      <button class="active" type="button" role="tab" aria-selected="true" aria-controls="panel-synthese" data-pilotage-tab="synthese"><span>01</span>Synthèse</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-simulateur" data-pilotage-tab="simulateur"><span>02</span>Simulateur</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-marche" data-pilotage-tab="marche"><span>03</span>Marché</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-investissements" data-pilotage-tab="investissements"><span>04</span>Investissements</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="panel-plan" data-pilotage-tab="plan"><span>05</span>Plan directeur</button>
    </nav>

    <section id="panel-synthese" class="pilotage-panel" role="tabpanel" data-pilotage-panel="synthese">
      <div class="pilotage-section-head">
        <div><p class="demo-kicker">Scénarios comparables</p><h2>Quatre façons d’ouvrir la maison.</h2></div>
        <p>Le prix public d’ouverture reste à 180 € dans le premier scénario. Les autres paliers traduisent les enseignements du benchmark sans les appliquer silencieusement au site commercial.</p>
      </div>

      <div class="pilotage-scenarios-v2" role="group" aria-label="Choisir un scénario">
        <button class="active" type="button" data-pilotage-scenario="family"><span>01 · VIE DE LA MAISON</span><strong>Prudence familiale</strong><small>180 € · 80 nuits/suite</small></button>
        <button type="button" data-pilotage-scenario="opening"><span>02 · MONTÉE EN CHARGE</span><strong>Ouverture affirmée</strong><small>205 € · 110 nuits/suite</small></button>
        <button type="button" data-pilotage-scenario="target"><span>03 · ÉQUILIBRE</span><strong>Cible de consolidation</strong><small>225 € · 140 nuits/suite</small></button>
        <button type="button" data-pilotage-scenario="maturity"><span>04 · MATURITÉ</span><strong>Premium démontré</strong><small>235 € · 155 nuits/suite</small></button>
      </div>

      <div class="pilotage-summary-grid" aria-live="polite">
        <article class="pilotage-summary-card primary"><span>Chiffre d’affaires simulé</span><strong data-pilotage-output="revenue">—</strong><small data-pilotage-output="revenue-note">—</small></article>
        <article class="pilotage-summary-card"><span>Solde d’exploitation</span><strong data-pilotage-output="result">—</strong><small>avant impôts, dette et amortissements</small></article>
        <article class="pilotage-summary-card"><span>Occupation</span><strong data-pilotage-output="occupancy">—</strong><small data-pilotage-output="occupied-detail">—</small></article>
        <article class="pilotage-summary-card"><span>Présence ressentie</span><strong data-pilotage-output="presence-days">—</strong><small>jours avec au moins une suite occupée</small></article>
      </div>

      <div class="pilotage-decision-grid">
        <article>
          <p class="demo-kicker">Diagnostic</p>
          <h3 data-pilotage-output="scenario-name">Prudence familiale</h3>
          <div class="pilotage-verdict" data-pilotage-verdict></div>
          <button class="demo-button" type="button" data-open-simulator>Explorer les hypothèses</button>
        </article>
        <article class="pilotage-market-position">
          <p class="demo-kicker">Position prix</p>
          <h3>Du lancement au prix démontré.</h3>
          <div class="price-ladder">
            <div><span>Failloux indicatif</span><strong>108 €</strong></div>
            <div><span>Ouverture validée</span><strong>180 €</strong></div>
            <div><span>Médiane 30 lieux</span><strong>210 €</strong></div>
            <div class="active"><span>Cible réalisée</span><strong>220–240 €</strong></div>
          </div>
        </article>
      </div>

      <div class="pilotage-section-head compact">
        <div><p class="demo-kicker">Preuves de valeur</p><h2>Ce que le client doit comprendre en quelques secondes.</h2></div>
      </div>
      <div class="pilotage-value-grid">
        <figure><Image src={suite} alt="Projection de la Suite Feuillage après travaux" widths={[440, 720]} sizes="(max-width: 760px) 100vw, 33vw" /><figcaption><strong>Une suite, pas une chambre.</strong><span>Volumes, salon séparé, terrasse et finitions irréprochables.</span></figcaption></figure>
        <figure><Image src={chemin} alt="Projection du chemin éclairé menant au bain nordique" widths={[440, 720]} sizes="(max-width: 760px) 100vw, 33vw" /><figcaption><strong>Un parc habité par la nuit.</strong><span>Le cheminement devient une expérience signature.</span></figcaption></figure>
        <figure><Image src={table} alt="Projection d’un dîner privatif servi au château" widths={[440, 720]} sizes="(max-width: 760px) 100vw, 33vw" /><figcaption><strong>Une hospitalité incarnée.</strong><span>Petit-déjeuner et table construisent autant la valeur que le spa.</span></figcaption></figure>
      </div>
    </section>

    <section id="panel-simulateur" class="pilotage-panel" role="tabpanel" data-pilotage-panel="simulateur" hidden>
      <div class="pilotage-section-head">
        <div><p class="demo-kicker">Modèle annuel interactif</p><h2>Tester le prix, le volume et la charge.</h2></div>
        <div class="pilotage-actions"><button class="demo-button secondary" type="button" data-pilotage-share>Copier le scénario</button><button class="demo-button quiet" type="button" data-pilotage-reset>Réinitialiser</button></div>
      </div>

      <div class="pilotage-workbench-v2">
        <form class="pilotage-controls-v2" data-pilotage-form>
          <details open>
            <summary><span>01</span>Capacité et vie de la maison</summary>
            <div class="demo-form-grid three">
              <label class="demo-field"><span class="label">Jours ouverts / an</span><input name="openDays" type="number" min="30" max="365" step="1" value="275" /></label>
              <label class="demo-field"><span class="label">Nuits vendues / suite</span><input name="nightsPerSuite" type="number" min="0" max="365" step="1" value="80" /></label>
              <label class="demo-field"><span class="label">Séjours regroupés</span><input name="overlapRate" type="number" min="0" max="100" step="5" value="75" /></label>
              <label class="demo-field"><span class="label">Durée moyenne</span><input name="los" type="number" min="1" max="14" step="0.1" value="2" /></label>
              <label class="demo-field"><span class="label">Voyageurs moyens</span><input name="avgGuests" type="number" min="1" max="4" step="0.1" value="2.1" /></label>
              <label class="demo-field"><span class="label">Heures opératoires / séjour</span><input name="hoursPerStay" type="number" min="0" max="30" step="0.5" value="6" /></label>
            </div>
            <p class="pilotage-help">Le regroupement rapproche les réservations des deux suites sur les mêmes dates. Il réduit les jours de présence ressentis sans réduire les nuits vendues.</p>
          </details>

          <details open>
            <summary><span>02</span>Prix, distribution et expériences</summary>
            <div class="demo-form-grid three">
              <label class="demo-field"><span class="label">Prix moyen réalisé</span><input name="adr" type="number" min="100" max="500" step="5" value="180" /></label>
              <label class="demo-field"><span class="label">Réservations directes</span><input name="directShare" type="number" min="0" max="100" step="5" value="40" /></label>
              <label class="demo-field"><span class="label">Commission plateformes</span><input name="otaCommission" type="number" min="0" max="30" step="1" value="15" /></label>
              <label class="demo-field"><span class="label">Politique bien-être</span><select data-spa-policy><option value="entry">Accès simple</option><option value="nordic">Parc nordique</option><option value="signature">Nuit aux lanternes</option><option value="custom">Personnalisée</option></select></label>
              <label class="demo-field"><span class="label">Acheteurs bien-être</span><input name="spaTake" type="number" min="0" max="100" step="5" value="30" /></label>
              <label class="demo-field"><span class="label">Panier bien-être / séjour</span><input name="spaBasket" type="number" min="0" max="400" step="5" value="50" /></label>
              <label class="demo-field"><span class="label">Séjours avec table</span><input name="dinnerTake" type="number" min="0" max="100" step="5" value="20" /></label>
              <label class="demo-field"><span class="label">Panier table / séjour</span><input name="dinnerBasket" type="number" min="0" max="400" step="5" value="90" /></label>
            </div>
          </details>

          <details>
            <summary><span>03</span>Coûts et obligations</summary>
            <div class="demo-form-grid three">
              <label class="demo-field"><span class="label">Remise en état / séjour</span><input name="turnoverCost" type="number" min="0" max="300" step="1" value="66" /></label>
              <label class="demo-field"><span class="label">Petit-déjeuner / pers. / nuit</span><input name="breakfastCost" type="number" min="0" max="50" step="0.5" value="7" /></label>
              <label class="demo-field"><span class="label">Énergie / nuit vendue</span><input name="energyCost" type="number" min="0" max="100" step="0.5" value="7.5" /></label>
              <label class="demo-field"><span class="label">Coût variable bien-être</span><input name="spaCostRate" type="number" min="0" max="100" step="1" value="28" /></label>
              <label class="demo-field"><span class="label">Coût variable table</span><input name="dinnerCostRate" type="number" min="0" max="100" step="1" value="35" /></label>
              <span aria-hidden="true"></span>
              <label class="demo-field"><span class="label">Loyer annuel SCI</span><input name="rent" type="number" min="0" max="100000" step="500" value="18000" /></label>
              <label class="demo-field"><span class="label">Coût employeur à confirmer</span><input name="salary" type="number" min="0" max="100000" step="500" value="30000" /></label>
              <label class="demo-field"><span class="label">Autres frais fixes provisoires</span><input name="otherFixed" type="number" min="0" max="100000" step="500" value="8000" /></label>
              <label class="demo-field"><span class="label">Investissement initial</span><input name="capex" type="number" min="0" max="500000" step="1000" value="65000" /></label>
            </div>
          </details>
        </form>

        <aside class="pilotage-live-results" aria-live="polite">
          <p class="demo-kicker">Résultat recalculé</p>
          <h3 data-pilotage-output="scenario-name">Prudence familiale</h3>
          <div class="pilotage-big-result"><span>Solde annuel</span><strong data-pilotage-output="result">—</strong></div>
          <div class="pilotage-result-row"><span>CA total</span><strong data-pilotage-output="revenue">—</strong></div>
          <div class="pilotage-result-row"><span>Marge contributive</span><strong data-pilotage-output="contribution">—</strong></div>
          <div class="pilotage-result-row"><span>Coûts variables</span><strong data-pilotage-output="variable-costs">—</strong></div>
          <div class="pilotage-result-row"><span>Obligations fixes</span><strong data-pilotage-output="fixed-costs">—</strong></div>
          <div class="pilotage-result-row"><span>Seuil d’équilibre</span><strong data-pilotage-output="break-even">—</strong></div>
          <div class="pilotage-result-row"><span>Retour simple des 65 k€</span><strong data-pilotage-output="payback">—</strong></div>
          <div class="pilotage-result-row"><span>Charge indicative</span><strong data-pilotage-output="operations-hours">—</strong></div>
          <div class="pilotage-revenue-mix">
            <span>Répartition du chiffre d’affaires</span>
            <div><i data-revenue-bar="accommodation"></i><i data-revenue-bar="spa"></i><i data-revenue-bar="dinner"></i></div>
            <small><b class="lodging-dot"></b> Hébergement <b class="spa-dot"></b> Bien-être <b class="dinner-dot"></b> Table</small>
          </div>
          <div class="pilotage-verdict" data-pilotage-verdict></div>
          <p class="pilotage-footnote">Avant impôts, dette, amortissements, TVA et rémunérations non saisies. Les heures opératoires sont une hypothèse à chronométrer.</p>
        </aside>
      </div>
    </section>

    <section id="panel-marche" class="pilotage-panel" role="tabpanel" data-pilotage-panel="marche" hidden>
      <div class="pilotage-section-head">
        <div><p class="demo-kicker">Benchmark documentaire</p><h2>30 lieux, cinq modèles concurrents.</h2></div>
        <p>Prix indicatifs pour deux personnes, variables selon date et canal. Ils servent à positionner le projet, pas à établir une comparaison commerciale garantie.</p>
      </div>
      <div class="pilotage-market-kpis">
        <article><span>Médiane Vosges</span><strong>206 €</strong><small>10 références</small></article>
        <article><span>Médiane France</span><strong>213 €</strong><small>20 références</small></article>
        <article><span>Médiane globale</span><strong>210 €</strong><small>30 références</small></article>
        <article><span>Cible réalisée</span><strong>220–240 €</strong><small>conditionnée par l’exécution</small></article>
      </div>
      <div class="pilotage-market-tools">
        <label class="demo-field"><span class="label">Périmètre du graphique</span><select data-market-scope><option value="vosges">Vosges · 10 lieux</option><option value="france">France · 20 lieux</option><option value="all">Ensemble · 30 lieux</option></select></label>
        <label class="demo-field"><span class="label">Examiner un lieu</span><select data-competitor-select></select></label>
      </div>
      <div class="pilotage-market-layout">
        <div class="pilotage-chart" data-market-chart aria-label="Comparaison des prix indicatifs"></div>
        <article class="pilotage-competitor-detail" data-competitor-detail></article>
      </div>
      <div class="pilotage-insights">
        <details open><summary>Le concurrent local direct</summary><p>Le Château de Failloux, autour de 108 € dans l’étude, impose une comparaison immédiate. L’écart ne peut être défendu que par la taille réelle des suites, la terrasse, la privatisation, la finition et une scénographie nocturne introuvable ailleurs.</p></details>
        <details><summary>Les cinq références centrales</summary><p>Failloux valide le marché local ; Landin rapproche patrimoine et bien-être ; Château Réal travaille le territoire ; Maison Durieux prouve le premium hors grande destination ; Château Duo monétise de grandes suites et un spa réellement privatif.</p></details>
        <details><summary>La recommandation tarifaire</summary><p>Conserver 180 € comme décision d’ouverture si la famille le souhaite, puis tester 205–225 € et viser un prix moyen réalisé de 220–240 €. Les dates fortes pourront porter davantage uniquement après preuves photographiques et avis clients.</p></details>
      </div>
    </section>

    <section id="panel-investissements" class="pilotage-panel" role="tabpanel" data-pilotage-panel="investissements" hidden>
      <div class="pilotage-section-head">
        <div><p class="demo-kicker">Chiffrage fournitures corrigé</p><h2>61–64 k€ estimés. 65 k€ à sécuriser.</h2></div>
        <p>Main-d’œuvre familiale non valorisée. Les montants doivent encore être remplacés par commandes, factures et provisions de trésorerie.</p>
      </div>
      <div class="pilotage-budget-overview">
        <article class="pilotage-budget-total"><span>Enveloppe conseillée</span><strong>65 000 € TTC</strong><div><i style="width: 60.8%"></i><i style="width: 35.4%"></i><i style="width: 3.8%"></i></div><small><b></b> Intérieur 39,5 k€ · <b></b> Extérieur 23 k€ médian · <b></b> Marge 2,5 k€</small></article>
        <article><span>Écart avec l’ancienne base</span><strong>+15 000 €</strong><p>L’ancienne hypothèse de 50 k€ ne doit plus servir au plan de financement.</p></article>
        <article><span>Fourchette documentée</span><strong>61–64 k€</strong><p>L’éclairage extérieur explique l’essentiel de la variation.</p></article>
      </div>
      <div class="pilotage-budget-grid">
        <article><span>Suites</span><strong>12 000 €</strong><i style="--share: 18.5%"></i><small>Mobilier, literie, textiles, miroirs, décoration</small></article>
        <article><span>Salles de bain</span><strong>21 500 €</strong><i style="--share: 33.1%"></i><small>Grande salle de bain 15 k€ + petite 6,5 k€</small></article>
        <article><span>Terrasses & finitions</span><strong>6 000 €</strong><i style="--share: 9.2%"></i><small>Deux terrasses et décoration complémentaire</small></article>
        <article><span>Allée & réseaux</span><strong>4 000 €</strong><i style="--share: 6.2%"></i><small>Cheminement, socles, drainage et divers</small></article>
        <article><span>Éclairage extérieur</span><strong>7 500–10 500 €</strong><i style="--share: 13.8%"></i><small>BEGA, câblage et gaines</small></article>
        <article><span>Bain & sauna</span><strong>10 000 €</strong><i style="--share: 15.4%"></i><small>Bain nordique qualitatif et sauna finlandais</small></article>
      </div>
      <div class="pilotage-priority">
        <Image src={chemin} alt="Projection du cheminement éclairé et du bain nordique" widths={[580, 900]} sizes="(max-width: 900px) 100vw, 48vw" />
        <div><p class="demo-kicker">Arbitrage recommandé</p><h3>Investir d’abord dans ce que les photos prouvent.</h3><ol><li>Deux salles de bain irréprochables.</li><li>Literie, linge, terrasses et stylisme.</li><li>Éclairage sûr, chaud et scénographique.</li><li>Une expérience signature parfaitement opérable.</li><li>Équipements secondaires seulement après stabilisation.</li></ol></div>
      </div>
    </section>

    <section id="panel-plan" class="pilotage-panel" role="tabpanel" data-pilotage-panel="plan" hidden>
      <div class="pilotage-section-head">
        <div><p class="demo-kicker">Chemin critique</p><h2>Les preuves à réunir avant avril 2027.</h2></div>
        <div class="pilotage-progress-copy"><strong data-roadmap-progress>0 %</strong><span>avancement enregistré sur cet appareil</span></div>
      </div>
      <div class="pilotage-progress"><i data-roadmap-progress-bar></i></div>
      <div class="pilotage-roadmap-v2">
        <details open>
          <summary><span>AOÛT–15 SEPT.</span><strong>Décider la structure</strong><em class="demo-status danger">Critique</em></summary>
          <p>La propriété, le payeur et le financement de chaque actif doivent être identifiés avant les commandes.</p>
          <label><input type="checkbox" data-roadmap-task="structure" /> Arbitrer société, TVA, capital et gouvernance</label>
          <label><input type="checkbox" data-roadmap-task="bail" /> Valider bail, loyer SCI et charges</label>
          <label><input type="checkbox" data-roadmap-task="salary" /> Chiffrer le coût employeur et le rôle de Jules</label>
          <label><input type="checkbox" data-roadmap-task="quotes" /> Obtenir les devis structurants et affecter chaque facture</label>
        </details>
        <details>
          <summary><span>SEPT.–OCT.</span><strong>Qualifier les obligations</strong><em class="demo-status warn">À instruire</em></summary>
          <p>Aucune promesse commerciale ne doit précéder la qualification écrite des usages sensibles.</p>
          <label><input type="checkbox" data-roadmap-task="erp" /> Position mairie/SDIS : sécurité, ERP et accessibilité</label>
          <label><input type="checkbox" data-roadmap-task="ars" /> Position ARS : piscine naturelle et équipements spa</label>
          <label><input type="checkbox" data-roadmap-task="food" /> Qualifier table, hygiène, allergènes et boissons</label>
          <label><input type="checkbox" data-roadmap-task="insurance" /> Sécuriser assurances travaux, murs et exploitation</label>
        </details>
        <details>
          <summary><span>NOV.–DÉC.</span><strong>Préparer la vente</strong><em class="demo-status simulated">Prévu</em></summary>
          <p>La communication peut commencer en décembre si elle distingue clairement projections et réalité.</p>
          <label><input type="checkbox" data-roadmap-task="pricing" /> Tester trois paliers tarifaires et leurs marges</label>
          <label><input type="checkbox" data-roadmap-task="cgv" /> Finaliser CGV, annulation, règlement et médiateur</label>
          <label><input type="checkbox" data-roadmap-task="signature" /> Définir une seule expérience signature vendable</label>
          <label><input type="checkbox" data-roadmap-task="prelaunch" /> Préparer liste d’attente et communication de pré-ouverture</label>
        </details>
        <details>
          <summary><span>JANV.–FÉV.</span><strong>Construire l’exploitation</strong><em class="demo-status simulated">Prévu</em></summary>
          <p>Le système d’information orchestre les opérations ; il ne remplace ni les procédures ni les responsabilités.</p>
          <label><input type="checkbox" data-roadmap-task="pms" /> Choisir PMS, paiement et canal de lancement</label>
          <label><input type="checkbox" data-roadmap-task="procedures" /> Écrire accueil, ménage, table, spa et incidents</label>
          <label><input type="checkbox" data-roadmap-task="registrations" /> Réaliser déclarations, taxe, emploi et licences</label>
          <label><input type="checkbox" data-roadmap-task="continuity" /> Tester les modes dégradés et le plan de continuité</label>
        </details>
        <details>
          <summary><span>MARS</span><strong>Recetter en conditions réelles</strong><em class="demo-status simulated">Prévu</em></summary>
          <p>Trois séjours à blanc doivent prouver la qualité, la sécurité et la soutenabilité du quotidien.</p>
          <label><input type="checkbox" data-roadmap-task="photos" /> Remplacer les projections par les photos réelles</label>
          <label><input type="checkbox" data-roadmap-task="dryruns" /> Réussir les scénarios direct, OTA et incident</label>
          <label><input type="checkbox" data-roadmap-task="timings" /> Chronométrer ménage, petit-déjeuner, spa et table</label>
          <label><input type="checkbox" data-roadmap-task="gono" /> Prononcer le go/no-go du 31 mars</label>
        </details>
        <details>
