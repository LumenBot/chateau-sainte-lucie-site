---
import { Image } from "astro:assets";
import DemoLayout from "../../layouts/DemoLayout.astro";
import { withBase } from "../../utils/url";
import {
  scenarioA,
  scenarioBCentral,
  scenarioBStretch,
  seasonalBreakEven,
  theoreticalCoupleBasket,
} from "../../data/operatingScenarios.mjs";
import "../../styles/scenarios.css";
import tableHotes from "../../assets/images/projection/table-hotes.jpg";
import spaTerrasse from "../../assets/images/projection/spa-terrasse.jpg";
import petitDejeuner from "../../assets/images/projection/petit-dejeuner-terrasse.jpg";
import piscine from "../../assets/images/projection/piscine-heure-bleue.jpg";

const money = (value: number) => new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(value);
const integer = (value: number) => new Intl.NumberFormat("fr-FR", { maximumFractionDigits: 0 }).format(value);
const percent = (value: number) => new Intl.NumberFormat("fr-FR", { style: "percent", maximumFractionDigits: 0 }).format(value);
const signedMoney = (value: number) => `${value >= 0 ? "+ " : "− "}${money(Math.abs(value))}`;

const months = ["Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre"];

const pnlA = [
  ["Ventes publiques TTC", scenarioA.publicRevenue, "revenue"],
  ["Coûts variables", 14364, "cost"],
  ["Charges fixes", 7000, "cost"],
  ["Jules · 0,80 ETP", 22400, "cost"],
  ["Relève rémunérée · 100 h", 2500, "cost"],
  ["Résultat avant loyer", 13736, "subtotal"],
  ["Loyer SCI", 12000, "cost"],
  ["Résultat après loyer", scenarioA.operatingResultAfterRent, "subtotal"],
  ["Renouvellement", scenarioA.renewal, "cash"],
  ["Trésorerie avant CCA", scenarioA.cashAfterRenewal, "total"],
  ["Service annuel du CCA OpCo", 3649.5, "cash"],
  ["Trésorerie OpCo après CCA", scenarioA.opcoCashAfterLoanService, "final"],
] as const;

const pnlB = [
  ["Ventes publiques TTC", scenarioBCentral.publicRevenue, "revenue"],
  ["Coûts variables", scenarioBCentral.variableCosts, "cost"],
  ["Charges fixes incluant le socle restauration", scenarioBCentral.fixedCosts, "cost"],
  ["Jules · 0,75 ETP", scenarioBCentral.julesCost, "cost"],
  ["Relève rémunérée · 150 h", scenarioBCentral.paidReliefCost, "cost"],
  ["Résultat avant loyer", scenarioBCentral.resultBeforeRent, "subtotal"],
  ["Loyer SCI", scenarioBCentral.rent, "cost"],
  ["Résultat après loyer", scenarioBCentral.resultAfterRent, "subtotal"],
  ["Renouvellement", scenarioBCentral.renewal, "cash"],
  ["Trésorerie avant CCA", scenarioBCentral.cashAfterRenewal, "total"],
  ["Service annuel du CCA OpCo", scenarioBCentral.opcoLoanService, "cash"],
  ["Trésorerie OpCo après CCA", scenarioBCentral.opcoCashAfterLoanService, "final"],
] as const;

const workloadB = [
  ["Parc, maintenance et administration", scenarioBCentral.baseHours],
  ["Présence clients et petits-déjeuners", scenarioBCentral.guestPresenceHours],
  ["Communs et nuits-suite", scenarioBCentral.commonAreasHours],
  ["Coordination des séjours", scenarioBCentral.coordinationHours],
  ["Ménage internalisé", scenarioBCentral.turnoverHours],
  ["Préparation du spa", scenarioBCentral.spaHours],
  ["Déjeuners", scenarioBCentral.lunchHours],
  ["Dîners", scenarioBCentral.dinnerHours],
  ["Bar et boissons", scenarioBCentral.barHours],
] as const;
---

<DemoLayout
  title="Comparatif des scénarios d’exploitation — Les Nuits au Château"
  description="Comparaison économique, humaine et stratégique entre le modèle annuel allégé et une ouverture saisonnière avec table d’hôtes."
  section="scenarios"
>
  <div class="demo-shell scenarios-page">
    <header class="scenarios-hero">
      <div class="scenarios-hero__copy">
        <p class="demo-kicker">Atelier de décision · photographie du 9 août 2026</p>
        <h1>Deux modèles.<br /><em class="gold light">Une même promesse.</em></h1>
        <p class="lede">Faut-il privilégier le volume maîtrisé d’une maison d’hôtes ouverte largement, ou concentrer l’expérience sur vingt-et-un week-ends avec une véritable table ? Cette page rend visibles le potentiel, le coût et l’engagement humain de chaque choix.</p>
        <div class="demo-actions">
          <button class="demo-button" type="button" data-scenario-share>Copier le lien de comparaison</button>
          <a class="demo-button secondary" href={withBase("/demo/pilotage#simulateur")}>Ouvrir le simulateur</a>
        </div>
      </div>
      <figure class="scenarios-hero__image">
        <Image src={tableHotes} alt="Projection de la table d’hôtes dressée devant la cheminée du château" widths={[620, 900, 1200]} sizes="(max-width: 900px) 100vw, 44vw" loading="eager" />
        <figcaption><strong>La table comme expérience.</strong><span>Projection d’intention après travaux · non contractuelle</span></figcaption>
      </figure>
    </header>

    <section class="scenario-verdict" aria-labelledby="verdict-title">
      <p class="demo-kicker">Conclusion de travail</p>
      <div>
        <h2 id="verdict-title">Le scénario saisonnier enrichit la promesse, mais son calendrier plafonne trop fortement le revenu.</h2>
        <p>Le modèle annuel allégé demeure le plus soutenable des deux. La table d’hôtes répond à un vrai défaut de l’offre locale et augmente fortement le panier, mais 63 nuits vendables par suite ne suffisent pas à financer simultanément 0,75 ETP, la relève, 12 k€ de loyer et le remboursement du CCA. La piste la plus solide est donc une <strong>hybridation : des week-ends de table signature à l’intérieur d’un calendrier plus large</strong>, après mesure réelle du temps et de la marge.</p>
      </div>
      <span class="scenario-verdict__badge">Avis recommandé</span>
    </section>

    <section class="scenario-arithmetic" aria-labelledby="arithmetic-title">
      <div>
        <p class="demo-kicker">Le calcul qui structure le débat</p>
        <h2 id="arithmetic-title">Le panier monte. Le plafond baisse.</h2>
      </div>
      <div class="scenario-equation" aria-label="Calcul de capacité du scénario saisonnier">
        <span><strong>7</strong> mois</span><b>×</b><span><strong>3</strong> semaines</span><b>×</b><span><strong>3</strong> nuits</span><b>=</b><span class="result"><strong>63</strong> nuits / suite</span>
      </div>
      <div class="scenario-arithmetic__facts">
        <article><span>Capacité totale</span><strong>126 nuits-suite</strong><small>deux suites, remplissage théorique de 100 %</small></article>
        <article><span>Panier maximal décrit</span><strong>{money(theoreticalCoupleBasket.total)}</strong><small>pour un couple et une nuit, hors consommations de bar supplémentaires</small></article>
        <article><span>CA maximal arithmétique</span><strong>{money(theoreticalCoupleBasket.annualRevenueAtCapacity)}</strong><small>si chaque suite achète chaque prestation chaque nuit</small></article>
      </div>
      <p class="scenario-correction"><strong>Clarification :</strong> les suppléments totalisent {money(theoreticalCoupleBasket.extrasIncludingSpa)}, et non 210 €. Les 210 € correspondent au déjeuner, au dîner et à l’accord pour deux, <em>hors spa</em>. Même en facturant toutes les nuits 220 €, le plafond hors bar ne serait que de 61 740 €.</p>
    </section>

    <nav class="scenario-jump" aria-label="Navigation dans la comparaison">
      <a href="#comparaison">Vue comparée</a>
      <a href="#scenario-a">Modèle diffus</a>
      <a href="#scenario-b">Week-ends de table</a>
      <a href="#recommandation">Recommandation</a>
    </nav>

    <section id="comparaison" class="scenario-section" aria-labelledby="comparison-title">
      <div class="scenario-section__head">
        <div><p class="demo-kicker">Lecture immédiate</p><h2 id="comparison-title">La comparaison en neuf indicateurs.</h2></div>
        <p>Les deux colonnes utilisent une franchise de TVA comme hypothèse de simulation et un loyer SCI de 12 k€. Les taux et régimes devront être validés avant décision.</p>
      </div>
      <div class="scenario-scorecard" role="table" aria-label="Comparaison des deux scénarios">
        <div class="scenario-scorecard__head" role="row">
          <span role="columnheader">Indicateur</span>
          <strong role="columnheader">A · Modèle diffus</strong>
          <strong role="columnheader">B · Week-ends de table</strong>
        </div>
        {[
          ["Nuits vendues / suite", `${scenarioA.soldNightsPerSuite}`, `${scenarioBCentral.soldNightsPerSuite} sur 63`],
          ["Prix moyen de la suite", money(scenarioA.averageNightPrice), money(scenarioBCentral.averageNightPrice)],
          ["Ventes publiques TTC", money(scenarioA.publicRevenue), money(scenarioBCentral.publicRevenue)],
          ["Panier total / nuit-suite", money(scenarioA.averageBasketPerSuiteNight), money(scenarioBCentral.averageBasketPerSuiteNight)],
          ["Extras / nuit-suite", money(scenarioA.averageExtrasPerSuiteNight), money(scenarioBCentral.averageExtrasPerSuiteNight)],
          ["Temps annuel à organiser", `${integer(scenarioA.operationsHours)} h`, `${integer(scenarioBCentral.operationsHours)} h`],
          ["Implication des associés", `${integer(scenarioA.familyHours)} h`, `${integer(scenarioBCentral.familyHours)} h`],
          ["Trésorerie avant CCA", signedMoney(scenarioA.cashAfterRenewal), signedMoney(scenarioBCentral.cashAfterRenewal)],
          ["Trésorerie après CCA OpCo", signedMoney(scenarioA.opcoCashAfterLoanService), signedMoney(scenarioBCentral.opcoCashAfterLoanService)],
        ].map(([label, a, b]) => (
          <div class="scenario-scorecard__row" role="row">
            <span role="rowheader">{label}</span><strong>{a}</strong><strong class:list={{ negative: String(b).startsWith("−") }}>{b}</strong>
          </div>
        ))}
      </div>
      <div class="scenario-reading-grid">
        <article><span>A</span><h3>Plus sobre, plus robuste</h3><p>Le chiffre d’affaires repose d’abord sur l’hébergement. Le modèle frôle l’équilibre courant mais demande encore beaucoup de temps familial et ne rembourse pas son CCA.</p></article>
        <article><span>B</span><h3>Plus désirable, plus fragile</h3><p>Les expériences représentent {percent(scenarioBCentral.experienceRevenue / scenarioBCentral.publicRevenue)} du revenu. La promesse gagne en valeur, mais la rareté volontaire des dates détruit davantage de capacité qu’elle ne crée de marge.</p></article>
      </div>
    </section>

    <section id="scenario-a" class="scenario-section scenario-detail" aria-labelledby="scenario-a-title">
      <div class="scenario-label"><span>A</span><small>{scenarioA.status}</small></div>
      <div class="scenario-detail__intro">
        <div><p class="demo-kicker">Exploitation annuelle allégée</p><h2 id="scenario-a-title">Vendre davantage de nuits.<br />Simplifier chaque séjour.</h2></div>
        <p>Deux suites commercialisées à 180–220 €, un spa facultatif et une planche du territoire simple. L’effort se répartit sur l’année ; la restauration ne devient pas le cœur du métier.</p>
      </div>

      <div class="scenario-kpis">
        <article><span>Activité</span><strong>120</strong><small>nuits vendues / suite / an</small></article>
        <article><span>Ventes</span><strong>{money(scenarioA.publicRevenue)}</strong><small>dont {money(scenarioA.experienceRevenue)} d’expériences</small></article>
        <article><span>Emploi</span><strong>0,80 ETP</strong><small>Jules + 100 h de relève</small></article>
        <article class="warn"><span>Après CCA OpCo</span><strong>{signedMoney(scenarioA.opcoCashAfterLoanService)}</strong><small>le remboursement n’est pas couvert</small></article>
      </div>

      <div class="scenario-offer-grid compact">
        <article><span>Suite nue</span><strong>180–220 €</strong><p>Parc et piscine naturelle inclus.</p></article>
        <article><span>Spa</span><strong>50 € / suite / jour</strong><p>Hammam et bain nordique, 75 % des séjours visés.</p></article>
        <article><span>Planche</span><strong>50 € / service</strong><p>Commande quotidienne simple, 25 % des nuits-suite visées.</p></article>
      </div>

      <div class="scenario-two-columns">
        <div>
          <h3>Ce que ce modèle protège</h3>
          <ul class="scenario-list positive">{scenarioA.strengths.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h3>Ce qu’il ne résout pas</h3>
          <ul class="scenario-list negative">{scenarioA.limits.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>

      <details class="scenario-details">
        <summary>Afficher le compte d’exploitation du scénario A</summary>
        <div class="scenario-pnl">
          {pnlA.map(([label, value, kind]) => <div class:list={["scenario-pnl__row", kind]}><span>{label}</span><strong>{kind === "cost" || kind === "cash" ? `− ${money(Number(value))}` : signedMoney(Number(value)).replace("+ ", "")}</strong></div>)}
        </div>
        <p class="scenario-note">Modèle simplifié avant impôt, dette bancaire et amortissements. Les {scenarioA.familyHours} h familiales ne sont pas rémunérées.</p>
      </details>
    </section>

    <section id="scenario-b" class="scenario-section scenario-detail seasonal" aria-labelledby="scenario-b-title">
      <div class="scenario-label"><span>B</span><small>Hypothèse à challenger</small></div>
      <div class="scenario-detail__intro">
        <div><p class="demo-kicker">Saison courte · table signature</p><h2 id="scenario-b-title">Ouvrir moins.<br />Servir davantage.</h2></div>
        <p>Une expérience concentrée d’avril à octobre, du jeudi au dimanche, trois semaines sur quatre. La restauration répond au manque d’offre locale et devient un élément central du séjour.</p>
      </div>

      <div class="season-calendar" aria-label="Calendrier annuel du scénario saisonnier">
        {months.map((month) => (
          <article>
            <span>{month}</span>
            <div aria-label="Trois semaines ouvertes, une semaine fermée"><i></i><i></i><i></i><i class="closed"></i></div>
            <small>9 nuits / suite</small>
          </article>
        ))}
      </div>

      <div class="scenario-visual-split">
        <figure><Image src={spaTerrasse} alt="Projection d’une table dressée sur la terrasse du spa au crépuscule" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption>Une expérience condensée, prévisible et scénographiée.</figcaption></figure>
        <div class="scenario-menu">
          <p class="demo-kicker">Carte de travail</p>
          <h3>Une offre courte, lisible et précommandée.</h3>
          <article><span>Spa quotidien</span><strong>60 €</strong><small>par suite · hammam et bain nordique</small></article>
          <article><span>Déjeuner snack</span><strong>25 €</strong><small>par personne · format terroir à définir</small></article>
          <article><span>Dîner table d’hôtes</span><strong>50 €</strong><small>par personne · menu unique</small></article>
          <article><span>Accord mets & vins</span><strong>30 €</strong><small>par personne · avec le dîner</small></article>
          <article><span>Bar de la maison</span><strong>sur demande</strong><small>hypothèse moyenne : 25 € par suite acheteuse</small></article>
        </div>
      </div>

      <div class="scenario-basket" aria-labelledby="basket-title">
        <div><p class="demo-kicker">Une nuit en formule complète · couple</p><h3 id="basket-title">{money(theoreticalCoupleBasket.total)} avant consommations de bar.</h3></div>
        <div class="scenario-basket__bar" aria-label="Composition du panier maximal">
          <i style={`--share:${theoreticalCoupleBasket.lodging / theoreticalCoupleBasket.total * 100}%`}><span>Suite</span><strong>{money(theoreticalCoupleBasket.lodging)}</strong></i>
          <i style={`--share:${theoreticalCoupleBasket.spa / theoreticalCoupleBasket.total * 100}%`}><span>Spa</span><strong>{money(theoreticalCoupleBasket.spa)}</strong></i>
          <i style={`--share:${theoreticalCoupleBasket.lunch / theoreticalCoupleBasket.total * 100}%`}><span>Déjeuner</span><strong>{money(theoreticalCoupleBasket.lunch)}</strong></i>
          <i style={`--share:${theoreticalCoupleBasket.dinner / theoreticalCoupleBasket.total * 100}%`}><span>Dîner</span><strong>{money(theoreticalCoupleBasket.dinner)}</strong></i>
          <i style={`--share:${theoreticalCoupleBasket.pairing / theoreticalCoupleBasket.total * 100}%`}><span>Accord</span><strong>{money(theoreticalCoupleBasket.pairing)}</strong></i>
        </div>
        <p>Ce panier est un plafond produit, pas un panier moyen : il suppose que deux personnes achètent toutes les prestations le même jour.</p>
      </div>

      <div class="scenario-kpis seasonal-kpis">
        <article><span>Activité centrale</span><strong>54 / 63</strong><small>nuits vendues / suite · {percent(scenarioBCentral.occupancyRate)} des dates ouvertes</small></article>
        <article><span>Ventes centrales</span><strong>{money(scenarioBCentral.publicRevenue)}</strong><small>panier moyen {money(scenarioBCentral.averageBasketPerSuiteNight)} / nuit-suite</small></article>
        <article><span>Emploi</span><strong>0,75 ETP</strong><small>Jules + 150 h payées + 100 h associées</small></article>
        <article class="negative"><span>Après CCA OpCo</span><strong>{signedMoney(scenarioBCentral.opcoCashAfterLoanService)}</strong><small>déficit annuel de l’hypothèse centrale</small></article>
      </div>

      <div class="scenario-assumptions">
        <article><span>Spa</span><strong>75 %</strong><small>des nuits-suite · {money(scenarioBCentral.spaRevenue)}</small></article>
        <article><span>Déjeuner</span><strong>45 %</strong><small>des nuits-suite · {money(scenarioBCentral.lunchRevenue)}</small></article>
        <article><span>Dîner</span><strong>75 %</strong><small>des nuits-suite · {money(scenarioBCentral.dinnerRevenue)}</small></article>
        <article><span>Accord</span><strong>50 %</strong><small>des convives au dîner · {money(scenarioBCentral.pairingRevenue)}</small></article>
        <article><span>Bar</span><strong>35 %</strong><small>des nuits-suite · {money(scenarioBCentral.barRevenue)}</small></article>
      </div>

      <div class="scenario-two-columns implication">
        <div>
          <p class="demo-kicker">Potentiel</p>
          <h3>Une vraie destination de court séjour.</h3>
          <ul class="scenario-list positive">
            <li>Le client n’a plus à arbitrer entre luxe au château et recherche d’un restaurant éloigné.</li>
            <li>Le panier moyen central atteint {money(scenarioBCentral.averageBasketPerSuiteNight)}, dont {money(scenarioBCentral.averageExtrasPerSuiteNight)} d’expériences.</li>
            <li>Les jours de service sont connus à l’avance ; les achats et les repos peuvent être planifiés.</li>
            <li>La table, le feu, le parc et le spa composent un récit de marque très différenciant.</li>
          </ul>
        </div>
        <div>
          <p class="demo-kicker">Fragilités</p>
          <h3>Une économie contrainte par son propre calendrier.</h3>
          <ul class="scenario-list negative">
            <li>À {money(scenarioBCentral.publicRevenue)} de ventes, il manque déjà {money(8000 + 21000 + 3750 + 12000 - scenarioBCentral.publicRevenue)} pour couvrir charges fixes, moyens humains et loyer — avant tout coût variable.</li>
            <li>Le scénario central mobilise déjà {integer(scenarioBCentral.operationsHours)} h pour {integer(scenarioBCentral.declaredCapacityHours)} h déclarées : la marge humaine est quasi nulle.</li>
            <li>Le service « toute la journée » crée une astreinte incompatible avec une petite équipe ; des créneaux fixes sont nécessaires.</li>
            <li>La rentabilité dépend de taux d’achat très élevés, notamment {percent(scenarioBCentral.dinnerTakeRate)} au dîner.</li>
          </ul>
        </div>
      </div>

      <details class="scenario-details" open>
        <summary>Compte d’exploitation · hypothèse centrale</summary>
        <div class="scenario-pnl">
          {pnlB.map(([label, value, kind]) => <div class:list={["scenario-pnl__row", kind]}><span>{label}</span><strong>{kind === "cost" || kind === "cash" ? `− ${money(Number(value))}` : signedMoney(Number(value)).replace("+ ", "")}</strong></div>)}
        </div>
        <p class="scenario-note">Hypothèse de franchise de TVA. Modèle avant impôt et amortissements. Les coûts matières incluent 10 € par déjeuner, 17,50 € par dîner, 12 € par accord et 35 % du bar. Ils doivent être remplacés par des fiches techniques et des devis.</p>
      </details>

      <details class="scenario-details">
        <summary>Charge humaine · hypothèse centrale</summary>
        <div class="scenario-workload">
          {workloadB.map(([label, value]) => <div><span>{label}</span><strong>{integer(Number(value))} h</strong></div>)}
          <div class="total"><span>Total annuel estimé</span><strong>{integer(scenarioBCentral.operationsHours)} h</strong></div>
          <div class="capacity"><span>Jules · 0,75 ETP</span><strong>{integer(scenarioBCentral.julesCapacityHours)} h</strong></div>
          <div class="capacity"><span>Relève rémunérée</span><strong>{integer(scenarioBCentral.paidReliefHours)} h</strong></div>
          <div class="capacity"><span>Associés</span><strong>{integer(scenarioBCentral.familyHours)} h</strong></div>
        </div>
        <p class="scenario-note">Le temps de dîner est évalué à 4 h par jour de service et le déjeuner à 1,5 h. Une ambition réellement gastronomique augmenterait sensiblement ces durées.</p>
      </details>

      <section class="scenario-stretch" aria-labelledby="stretch-title">
        <div><p class="demo-kicker">Test de tension</p><h3 id="stretch-title">Même plein, le calendrier reste trop court.</h3><p>Le test ci-dessous suppose toutes les dates vendues, un prix moyen de 210 €, 85 % de spa et dîner, 60 % de déjeuner, 65 % d’accord et 50 % de bar.</p></div>
        <div class="scenario-stretch__numbers">
          <article><span>Ventes TTC</span><strong>{money(scenarioBStretch.publicRevenue)}</strong><small>{money(scenarioBStretch.averageBasketPerSuiteNight)} / nuit-suite</small></article>
          <article><span>Après loyer et renouvellement</span><strong>{signedMoney(scenarioBStretch.cashAfterRenewal)}</strong><small>avant CCA</small></article>
          <article><span>Temps non couvert</span><strong>{integer(scenarioBStretch.staffingGapHours)} h</strong><small>à rémunérer ou répartir</small></article>
        </div>
      </section>

      <section class="scenario-break-even" aria-labelledby="break-even-title">
        <figure><Image src={piscine} alt="Piscine naturelle éclairée à l’heure bleue" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 43vw" /><figcaption>La désirabilité ne supprime pas le plafond de capacité.</figcaption></figure>
        <div>
          <p class="demo-kicker">Point mort indicatif</p>
          <h3 id="break-even-title">Environ {money(seasonalBreakEven.averageBasketAtCapacityBeforeLoan)} par nuit-suite vendable.</h3>
          <p>À structure de marge constante et avec 100 % de remplissage, il faudrait environ {money(seasonalBreakEven.publicRevenueBeforeLoan)} de ventes pour couvrir Jules à 75 %, la relève, les charges, le loyer et le renouvellement — avant remboursement du CCA.</p>
          <p>Après service du CCA OpCo, le besoin monte vers <strong>{money(seasonalBreakEven.averageBasketAtCapacityAfterLoan)} par nuit-suite</strong>. C’est supérieur au panier complet de {money(theoreticalCoupleBasket.total)} décrit pour un couple, avant même de financer des heures supplémentaires.</p>
        </div>
      </section>

      <aside class="scenario-regulatory" aria-labelledby="regulatory-title">
        <div><p class="demo-kicker">Cadre à sécuriser</p><h3 id="regulatory-title">Table d’hôtes oui ; bar permanent, à qualifier.</h3></div>
        <p>Le régime simplifié de la table d’hôtes suppose notamment un menu unique, réservé aux occupants, servi à une table unique et fondé sur une cuisine locale. La fiche officielle prévoit un prix affiché boissons comprises et un alcool servi pendant les repas, avec permis et licence. Le cumul déjeuner + dîner, l’accord facturé séparément et des cocktails « toute la journée » doivent donc être qualifiés : la version opérationnelle devrait privilégier un service unique, une sélection en chambre ou des horaires définis, puis être validée avec la mairie et la DDPP.</p>
        <div><a href="https://www.service-public.fr/particuliers/vosdroits/F17452" target="_blank" rel="noreferrer">Règles officielles · chambres et table d’hôtes</a><a href="https://entreprendre.service-public.fr/vosdroits/F22379" target="_blank" rel="noreferrer">Licence restaurant et boissons</a></div>
      </aside>
    </section>

    <section id="recommandation" class="scenario-section scenario-recommendation" aria-labelledby="recommendation-title">
      <div class="scenario-recommendation__image"><Image src={petitDejeuner} alt="Petit-déjeuner servi sur la terrasse du château au matin" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 44vw" /></div>
      <div>
        <p class="demo-kicker">Voie recommandée</p>
        <h2 id="recommendation-title">Tester la table sans condamner la capacité.</h2>
        <p>Le besoin client est réel ; le scénario strict ne le finance pas. La meilleure prochaine étape est un modèle hybride, mesuré sur quelques week-ends avant toute réduction irréversible du calendrier.</p>
        <ol>
          <li><strong>Conserver le modèle A comme socle de commercialisation.</strong><span>Il reste imparfait, mais son volume absorbe mieux les coûts fixes.</span></li>
          <li><strong>Programmer 1 à 2 week-ends « table du château » par mois.</strong><span>Menu unique, réservation 48 h avant, heure de service fixe et jauge limitée aux hôtes.</span></li>
          <li><strong>Transformer le bar permanent en rituel léger.</strong><span>Carte courte, plateau en suite ou créneau apéritif ; aucune promesse de disponibilité continue.</span></li>
          <li><strong>Mesurer quatre données pendant trois mois.</strong><span>Taux d’achat, marge matière, minutes réelles par service et impact sur les avis.</span></li>
          <li><strong>Décider ensuite du calendrier.</strong><span>Étendre la table si elle contribue réellement à la marge ; réduire l’ouverture seulement si le panier observé le justifie.</span></li>
        </ol>
      </div>
    </section>

    <section class="scenario-decisions" aria-labelledby="decisions-title">
      <div class="scenario-section__head">
        <div><p class="demo-kicker">Questions à trancher en famille</p><h2 id="decisions-title">Ce que cette comparaison doit permettre de décider.</h2></div>
      </div>
      <div>
        <article><span>01</span><h3>Quel calendrier protège la vie familiale ?</h3><p>Le volume annuel diffuse la charge ; les week-ends signature la concentrent sur des journées très intenses.</p></article>
        <article><span>02</span><h3>Quelle restauration voulons-nous réellement opérer ?</h3><p>Planche prête à servir, menu unique cuisiné, ou partenariat local livré : le temps et la marge n’ont rien de comparable.</p></article>
        <article><span>03</span><h3>Combien d’heures chaque associé garantit-il ?</h3><p>100 h représentent 12,5 journées de 8 h à planifier. Une promesse vague ne constitue pas une relève.</p></article>
        <article><span>04</span><h3>Quel seuil valide le test ?</h3><p>Proposition : au moins 60 % de dîners, 65 % de marge après matières et moins de 4 h de travail par service.</p></article>
      </div>
    </section>

    <footer class="scenario-method">
      <strong>Méthode et statut des chiffres.</strong>
      <p>Le scénario A reprend le simulateur sauvegardé. Le scénario B est une modélisation d’étude : 54 nuits vendues sur 63, deux suites, 2,1 personnes et 2,5 nuits par séjour. Les probabilités de service tiennent compte de la présence possible des deux suites le même jour. Les coûts, heures et taux d’achat sont des hypothèses de pilotage à remplacer par des fiches techniques, devis, chronométrages et validations professionnelles. Les projections visuelles sont des images d’intention après travaux.</p>
