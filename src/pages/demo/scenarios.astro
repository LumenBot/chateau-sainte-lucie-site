---
import { Image } from "astro:assets";
import DemoLayout from "../../layouts/DemoLayout.astro";
import { withBase } from "../../utils/url";
import {
  ambitiousConsolidation,
  ambitiousLowerActivity,
  ambitiousReference,
  ambitiousSixYearRepayment,
  ambitiousTwoSuiteCounterfactual,
  hybridActivityCases,
  scenarioA,
  scenarioBCentral,
  scenarioBStretch,
  seasonalBreakEven,
  shareholderAdvance,
  theoreticalCoupleBasket,
} from "../../data/operatingScenarios.mjs";
import "../../styles/scenarios.css";
import tableHotes from "../../assets/images/projection/table-hotes.jpg";
import spaTerrasse from "../../assets/images/projection/spa-terrasse.jpg";
import petitDejeuner from "../../assets/images/projection/petit-dejeuner-terrasse.jpg";
import piscine from "../../assets/images/projection/piscine-heure-bleue.jpg";
import maisonGardien from "../../assets/images/06_maison_gardien_crop.jpeg";

const money = (value: number) => new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(value);
const integer = (value: number) => new Intl.NumberFormat("fr-FR", { maximumFractionDigits: 0 }).format(value);
const percent = (value: number) => new Intl.NumberFormat("fr-FR", { style: "percent", maximumFractionDigits: 0 }).format(value);
const signedMoney = (value: number) => `${value >= 0 ? "+ " : "− "}${money(Math.abs(value))}`;
const fteLabel = (value: number) => value === 0 ? "aucun salaire" : value >= 1 ? "temps plein" : `${integer(value * 100)} % d’un temps plein`;

const months = ["Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre"];
const scenarioASciCash = scenarioA.rent - shareholderAdvance.sciAnnualPrincipal;
const scenarioAConsolidatedCash = scenarioA.operatingCompanyCashAfterPrincipalRepayment + scenarioASciCash;
const scenarioBSciCash = scenarioBCentral.rent - shareholderAdvance.sciAnnualPrincipal;
const scenarioBConsolidatedCash = scenarioBCentral.operatingCompanyCashAfterPrincipalRepayment + scenarioBSciCash;
const scenarioBStretchConsolidatedCash = scenarioBStretch.operatingCompanyCashAfterPrincipalRepayment + scenarioBSciCash;
const thirdSuiteRevenueEffect = ambitiousReference.publicRevenueTtc - ambitiousTwoSuiteCounterfactual.publicRevenueTtc;
const thirdSuiteCashEffect = ambitiousReference.cashAfterShareholderAdvanceRepayment - ambitiousTwoSuiteCounterfactual.cashAfterShareholderAdvanceRepayment;

const pnlA = [
  ["Ventes publiques TTC", scenarioA.publicRevenue, "revenue"],
  ["Coûts variables", 14364, "cost"],
  ["Charges fixes", 7000, "cost"],
  ["Jules · 80 % d’un temps plein", 22400, "cost"],
  ["Relève rémunérée · 100 h", 2500, "cost"],
  ["Résultat avant loyer", 13736, "subtotal"],
  ["Loyer versé à la SCI", 12000, "cost"],
  ["Résultat après loyer", scenarioA.operatingResultAfterRent, "subtotal"],
  ["Renouvellement des équipements", scenarioA.renewal, "cash"],
  ["Trésorerie avant remboursement", scenarioA.cashAfterRenewal, "total"],
  ["Remboursement annuel côté exploitation", shareholderAdvance.operatingCompanyAnnualPrincipal, "cash"],
  ["Solde de la société d’exploitation", scenarioA.operatingCompanyCashAfterPrincipalRepayment, "final"],
] as const;

const pnlB = [
  ["Ventes publiques TTC", scenarioBCentral.publicRevenue, "revenue"],
  ["Coûts variables", scenarioBCentral.variableCosts, "cost"],
  ["Charges fixes avec socle restauration", scenarioBCentral.fixedCosts, "cost"],
  ["Jules · 75 % d’un temps plein", scenarioBCentral.julesCost, "cost"],
  ["Relève rémunérée · 150 h", scenarioBCentral.paidReliefCost, "cost"],
  ["Résultat avant loyer", scenarioBCentral.resultBeforeRent, "subtotal"],
  ["Loyer versé à la SCI", scenarioBCentral.rent, "cost"],
  ["Résultat après loyer", scenarioBCentral.resultAfterRent, "subtotal"],
  ["Renouvellement des équipements", scenarioBCentral.renewal, "cash"],
  ["Trésorerie avant remboursement", scenarioBCentral.cashAfterRenewal, "total"],
  ["Remboursement annuel côté exploitation", scenarioBCentral.operatingCompanyAnnualPrincipal, "cash"],
  ["Solde de la société d’exploitation", scenarioBCentral.operatingCompanyCashAfterPrincipalRepayment, "final"],
] as const;

const pnlC = [
  ["Ventes publiques TTC", ambitiousReference.publicRevenueTtc, "revenue"],
  ["TVA comprise dans les ventes", ambitiousReference.collectedVat, "cost"],
  ["Produit comptable simulé", ambitiousReference.accountingRevenue, "subtotal"],
  ["Coûts variables après récupération estimée", ambitiousReference.variableCosts, "cost"],
  ["Charges fixes après récupération estimée", ambitiousReference.fixedCosts, "cost"],
  ["Jules · un temps plein", ambitiousReference.julesCost, "cost"],
  [`Relève prudente · ${integer(ambitiousReference.paidReliefHours)} h`, ambitiousReference.paidReliefCost, "cost"],
  ["Résultat avant loyer", ambitiousReference.resultBeforeRent, "subtotal"],
  ["Loyer versé à la SCI", ambitiousReference.rent, "cost"],
  ["Renouvellement des équipements", ambitiousReference.renewal, "cash"],
  ["Trésorerie de l’exploitation avant remboursement", ambitiousReference.operatingCompanyCashBeforeFinancing, "total"],
  ["Remboursement annuel côté exploitation", ambitiousReference.operatingCompanyAnnualPrincipalRepayment, "cash"],
  ["Solde de la société d’exploitation", ambitiousReference.operatingCompanyCashAfterShareholderAdvanceRepayment, "final-positive"],
] as const;

const workloadB = [
  ["Parc, maintenance et administration", scenarioBCentral.baseHours],
  ["Présence clients et petits-déjeuners", scenarioBCentral.guestPresenceHours],
  ["Communs et nuits-suite", scenarioBCentral.commonAreasHours],
  ["Coordination des séjours", scenarioBCentral.coordinationHours],
  ["Ménage internalisé", scenarioBCentral.turnoverHours],
  ["Préparation du spa", scenarioBCentral.spaHours],
  ["Déjeuners", scenarioBCentral.lunchHours],
  ["Dîners", scenarioBCentral.dinnerHours],
  ["Bar et boissons", scenarioBCentral.barHours],
] as const;
---

<DemoLayout
  title="Aide à la décision — Les Nuits au Château"
  description="Comprendre trois modèles d’exploitation, leurs enseignements et le compromis recommandé pour les Suites de Sainte-Lucie."
  section="scenarios"
>
  <div class="demo-shell scenarios-page">
    <header class="scenarios-hero decision-hero">
      <div class="scenarios-hero__copy">
        <p class="demo-kicker">Aide à la décision · document autonome · 9 août 2026</p>
        <h1>Trois façons de<br /><em class="gold light">faire vivre le château.</em></h1>
        <p class="lede">Cette page part de zéro. Elle expose trois manières d’exploiter Les Nuits au Château, explique la raison d’être de chacune, puis compare leurs conséquences économiques et humaines avant de proposer un compromis.</p>
        <div class="demo-actions">
          <button class="demo-button" type="button" data-scenario-share>Copier ce lien</button>
          <a class="demo-button secondary" href="#scenario-a">Commencer la lecture</a>
        </div>
      </div>
      <figure class="scenarios-hero__image">
        <Image src={tableHotes} alt="Projection de la table d’hôtes dressée devant la cheminée du château" widths={[620, 900, 1200]} sizes="(max-width: 900px) 100vw, 44vw" loading="eager" />
        <figcaption><strong>Une demeure privée à ouvrir sans la banaliser.</strong><span>Projection d’intention après travaux · non contractuelle</span></figcaption>
      </figure>
    </header>

    <section id="contexte" class="decision-context" aria-labelledby="context-title">
      <div class="decision-context__intro">
        <p class="demo-kicker">Le point de départ</p>
        <h2 id="context-title">Un même lieu. Trois questions stratégiques.</h2>
        <p>Le projet initial prévoit deux suites haut de gamme au Château de Sainte-Lucie, dans une grille publique de 180 à 220 € la nuit. Le séjour donne accès au parc et à la piscine naturelle ; le hammam, le bain nordique et la restauration complètent l’expérience. Une Maisonnette intégrée au château pourrait devenir une troisième suite moyennant 30 000 € de travaux supplémentaires.</p>
      </div>
      <div class="decision-context__facts">
        <article><span>01 · Désirabilité</span><strong>Comment bien dîner ?</strong><p>L’offre de restauration autour de Rambervillers est limitée. Une expérience premium doit garantir une solution simple et qualitative chaque soir.</p></article>
        <article><span>02 · Travail</span><strong>Qui fait réellement quoi ?</strong><p>Le modèle doit rémunérer Jules selon la charge, organiser ses repos et rendre visible toute contribution demandée aux associés.</p></article>
        <article><span>03 · Économie</span><strong>Quelle échelle suffit ?</strong><p>L’activité doit supporter 12 000 € de loyer annuel à la SCI et restituer les avances familiales sans dépendre d’un effort invisible.</p></article>
      </div>
    </section>

    <section class="decision-baseline" aria-labelledby="baseline-title">
      <div>
        <p class="demo-kicker">Convention financière commune</p>
        <h2 id="baseline-title">Des avances familiales, sans autre ressource simulée.</h2>
      </div>
      <div class="decision-baseline__grid">
        <article><span>Projet initial</span><strong>50 000 €</strong><small>comptes courants d’associés pour les deux suites et le lancement</small></article>
        <article><span>Option Maisonnette</span><strong>+ 30 000 €</strong><small>compte courant supplémentaire si la troisième suite est retenue</small></article>
        <article><span>Projet à trois suites</span><strong>80 000 €</strong><small>avance totale remboursable, sans intérêt dans la simulation</small></article>
        <article><span>Cible de restitution</span><strong>5 ans</strong><small>10 000 € par an à deux suites ; 16 000 € par an à trois suites</small></article>
      </div>
      <p class="scenario-note standalone"><strong>Comment lire les résultats :</strong> le compte courant d’associé est une avance remboursable, pas une charge d’exploitation. La page mesure la capacité économique du projet à la restituer. Le loyer versé par l’exploitation est simultanément un produit pour la SCI : il est neutralisé dans le solde consolidé afin de ne pas le compter deux fois.</p>
    </section>

    <section class="scenario-section scenario-framing" aria-labelledby="questions-title">
      <div class="scenario-section__head">
        <div><p class="demo-kicker">La logique de l’exercice</p><h2 id="questions-title">Chaque scénario isole une question différente.</h2></div>
        <p>Ils ne sont pas trois versions décoratives du même budget. Chacun pousse une intuition jusqu’à ses conséquences pour en extraire un enseignement utile.</p>
      </div>
      <div class="scenario-reading-grid scenario-introductions">
        <article><span>A</span><p class="demo-kicker">Simplicité</p><h3>Faire simple pour ouvrir souvent.</h3><p>Deux suites, un calendrier large, un spa en option et une restauration très légère peuvent-ils financer le socle du projet ?</p></article>
        <article><span>B</span><p class="demo-kicker">Intensité</p><h3>Ouvrir peu, servir beaucoup.</h3><p>Un séjour complet et un panier très élevé peuvent-ils compenser une saison courte et peu de nuits disponibles ?</p></article>
        <article class="ambitious"><span>C</span><p class="demo-kicker">Capacité</p><h3>Changer d’échelle avec la Maisonnette.</h3><p>Une troisième suite peut-elle absorber la structure, financer Jules à temps plein et rembourser 80 000 € d’avances ?</p></article>
      </div>
    </section>

    <nav class="scenario-jump" aria-label="Navigation dans l’aide à la décision">
      <a href="#contexte">Contexte</a>
      <a href="#scenario-a">Scénario A</a>
      <a href="#scenario-b">Scénario B</a>
      <a href="#scenario-c">Scénario C</a>
      <a href="#comparaison">Comparer</a>
      <a href="#recommandation">Recommandation</a>
      <a href="#decisions">Décider</a>
    </nav>

    <section id="scenario-a" class="scenario-section scenario-detail" aria-labelledby="scenario-a-title">
      <div class="scenario-label"><span>A</span><small>Socle agile</small></div>
      <div class="scenario-detail__intro">
        <div><p class="demo-kicker">Question étudiée · simplicité</p><h2 id="scenario-a-title">Faire simple pour ouvrir souvent.</h2></div>
        <p><strong>Pourquoi l’étudier ?</strong> Il représente le lancement le moins complexe : deux suites disponibles largement, des prestations faciles à produire et aucun investissement supplémentaire dans la Maisonnette.</p>
      </div>
      <div class="scenario-purpose">
        <article><span>Ce qu’il cherche à prouver</span><p>Qu’un calendrier ouvert et une offre volontairement légère peuvent financer le loyer, une rémunération partielle de Jules et le remboursement du projet initial.</p></article>
        <article><span>Comment il fonctionne</span><p>La chambre et le lieu portent la valeur. Le spa est optionnel ; la restauration prend la forme d’une planche de produits du territoire prête à dresser.</p></article>
      </div>
      <div class="scenario-offer-grid compact">
        <article><span>Capacité</span><strong>2 × 120 nuits</strong><p>240 nuits-suite vendues sur un calendrier souple.</p></article>
        <article><span>Suite</span><strong>200 € en moyenne</strong><p>Dans la grille publique de 180 à 220 €, petit-déjeuner inclus.</p></article>
        <article><span>Expériences</span><strong>50 € / nuit-suite</strong><p>Spa et planche du territoire agrégés dans le panier moyen.</p></article>
      </div>
      <div class="scenario-kpis">
        <article><span>Ventes publiques</span><strong>{money(scenarioA.publicRevenue)}</strong><small>dont {money(scenarioA.experienceRevenue)} d’expériences</small></article>
        <article><span>Travail à organiser</span><strong>{integer(scenarioA.operationsHours)} h</strong><small>presque toute la capacité disponible est mobilisée</small></article>
        <article><span>Organisation humaine</span><strong>80 %</strong><small>Jules + 100 h payées + 380 h familiales</small></article>
        <article class="warn"><span>Solde consolidé comparable</span><strong>{signedMoney(scenarioAConsolidatedCash)}</strong><small>après 10 000 € de remboursement annuel total</small></article>
      </div>
      <div class="scenario-two-columns">
        <div><h3>Ce que ce modèle apporte</h3><ul class="scenario-list positive"><li>Une grande disponibilité commerciale pour capter les week-ends, vacances et demandes opportunistes.</li><li>Une promesse simple à expliquer et plus facile à maintenir au quotidien.</li><li>Un risque produit limité : les clients viennent d’abord pour le château, le parc et les suites.</li></ul></div>
        <div><h3>Ce qu’il ne résout pas</h3><ul class="scenario-list negative"><li>Les 380 h familiales représentent près de 48 journées de huit heures.</li><li>La société d’exploitation reste à {signedMoney(scenarioA.operatingCompanyCashAfterPrincipalRepayment)} après son propre remboursement.</li><li>L’absence de solution de dîner plus complète peut limiter les séjours premium.</li></ul></div>
      </div>
      <div class="scenario-lesson"><span>Enseignement A</span><strong>Le calendrier ouvert et la simplicité sont précieux, mais deux suites à 120 nuits ne suffisent pas encore à rendre l’exploitation autonome.</strong><p>Ce scénario est « léger » pour le client ; il ne l’est pas pour la famille. Il constitue néanmoins la meilleure base de lancement si les 30 000 € supplémentaires ne sont pas mobilisables.</p></div>
      <details class="scenario-details">
        <summary>Voir le calcul de la société d’exploitation</summary>
        <div class="scenario-pnl">{pnlA.map(([label, value, kind]) => <div class:list={["scenario-pnl__row", kind]}><span>{label}</span><strong>{kind === "cost" || kind === "cash" ? `− ${money(Number(value))}` : signedMoney(Number(value)).replace("+ ", "")}</strong></div>)}</div>
        <p class="scenario-note">La SCI reçoit 12 000 € de loyer et rembourse 7 000 € d’avance, soit +5 000 € avant ses autres charges. Ajouté au solde de l’exploitation, le projet consolidé ressort à {signedMoney(scenarioAConsolidatedCash)}.</p>
      </details>
      <a class="scenario-model-link" href={withBase("/demo/pilotage?scenario=socle#simulateur")}>Modifier les hypothèses du scénario A</a>
    </section>

    <section id="scenario-b" class="scenario-section scenario-detail seasonal" aria-labelledby="scenario-b-title">
      <div class="scenario-label"><span>B</span><small>Saison signature</small></div>
      <div class="scenario-detail__intro">
        <div><p class="demo-kicker">Question étudiée · intensité</p><h2 id="scenario-b-title">Créer un rendez-vous premium.</h2></div>
        <p><strong>Pourquoi l’étudier ?</strong> La restauration rare autour de Rambervillers peut freiner le séjour. Ce scénario teste une réponse radicale : ouvrir moins souvent, mais proposer spa, déjeuner, dîner, vins et bar à chaque date.</p>
      </div>
      <div class="scenario-purpose">
        <article><span>Ce qu’il cherche à prouver</span><p>Qu’un panier très élevé et une expérience entièrement prise en charge pourraient compenser un calendrier volontairement réduit.</p></article>
        <article><span>Comment il fonctionne</span><p>Avril à octobre, trois semaines sur quatre, du jeudi au dimanche. Les prestations sont courtes, précommandées et concentrées sur des journées de service identifiées.</p></article>
      </div>
      <div class="season-calendar" aria-label="Calendrier annuel du scénario saisonnier">
        {months.map((month) => <article><span>{month}</span><div aria-label="Trois semaines ouvertes, une semaine fermée"><i></i><i></i><i></i><i class="closed"></i></div><small>9 nuits / suite</small></article>)}
      </div>
      <div class="scenario-visual-split">
        <figure><Image src={spaTerrasse} alt="Projection d’une table dressée sur la terrasse du spa au crépuscule" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption>Une expérience condensée, prévisible et scénographiée.</figcaption></figure>
        <div class="scenario-menu">
          <p class="demo-kicker">Carte de travail</p><h3>Une offre courte et précommandée.</h3>
          <article><span>Spa quotidien</span><strong>60 €</strong><small>par suite · hammam et bain nordique</small></article>
          <article><span>Déjeuner snack</span><strong>25 €</strong><small>par personne</small></article>
          <article><span>Dîner table d’hôtes</span><strong>50 €</strong><small>par personne · menu unique</small></article>
          <article><span>Accord mets et vins</span><strong>30 €</strong><small>par personne · avec le dîner</small></article>
          <article><span>Bar de la maison</span><strong>sur demande</strong><small>hypothèse moyenne : 25 € par suite acheteuse</small></article>
        </div>
      </div>
      <div class="scenario-basket"><div><p class="demo-kicker">Plafond produit · une nuit · un couple</p><h3>{money(theoreticalCoupleBasket.total)} avant consommations de bar.</h3></div><p>Ce montant suppose l’achat de toutes les prestations. Le scénario central retient 54 nuits vendues sur 63 possibles par suite et un panier moyen plus bas.</p></div>
      <div class="scenario-kpis seasonal-kpis">
        <article><span>Activité centrale</span><strong>54 / 63</strong><small>nuits / suite · {percent(scenarioBCentral.occupancyRate)} des dates ouvertes</small></article>
        <article><span>Ventes publiques</span><strong>{money(scenarioBCentral.publicRevenue)}</strong><small>{money(scenarioBCentral.averageBasketPerSuiteNight)} par nuit-suite</small></article>
        <article><span>Travail à organiser</span><strong>{integer(scenarioBCentral.operationsHours)} h</strong><small>Jules à 75 % + 150 h payées + 100 h familiales</small></article>
        <article class="negative"><span>Solde consolidé comparable</span><strong>{signedMoney(scenarioBConsolidatedCash)}</strong><small>après 10 000 € de remboursement annuel total</small></article>
      </div>
      <div class="scenario-two-columns implication">
        <div><h3>Ce que ce modèle apporte</h3><ul class="scenario-list positive"><li>Il répond directement au problème du dîner et renforce la sensation de séjour privatif.</li><li>Il crée un récit de marque distinctif autour de la table, du feu, du parc et du spa.</li><li>Les achats, mises en place et repos sont concentrés sur des dates connues.</li></ul></div>
        <div><h3>Ce qu’il ne résout pas</h3><ul class="scenario-list negative"><li>Le calendrier limite mécaniquement la capacité à 63 nuits par suite.</li><li>Les journées cumulent petits-déjeuners, ménage, spa, déjeuner, dîner et boissons.</li><li>Même à pleine capacité, le solde consolidé reste à {signedMoney(scenarioBStretchConsolidatedCash)} et {integer(scenarioBStretch.staffingGapHours)} h ne sont pas couvertes.</li></ul></div>
      </div>
      <div class="scenario-lesson"><span>Enseignement B</span><strong>Un panier élevé ne compense pas automatiquement la destruction de capacité.</strong><p>La table d’hôtes est une excellente source de désirabilité, mais un mauvais socle permanent. Son enseignement doit être réutilisé sous forme de dates signature, pas comme calendrier annuel exclusif.</p></div>
      <details class="scenario-details">
        <summary>Voir le calcul de la société d’exploitation</summary>
        <div class="scenario-pnl">{pnlB.map(([label, value, kind]) => <div class:list={["scenario-pnl__row", kind]}><span>{label}</span><strong>{kind === "cost" || kind === "cash" ? `− ${money(Number(value))}` : signedMoney(Number(value)).replace("+ ", "")}</strong></div>)}</div>
        <p class="scenario-note">La SCI conserve +5 000 € après remboursement de sa part d’avance. Le solde consolidé du scénario central ressort néanmoins à {signedMoney(scenarioBConsolidatedCash)}.</p>
      </details>
      <details class="scenario-details">
        <summary>Voir les {integer(scenarioBCentral.operationsHours)} heures estimées</summary>
        <div class="scenario-workload">{workloadB.map(([label, value]) => <div><span>{label}</span><strong>{integer(Number(value))} h</strong></div>)}<div class="total"><span>Total annuel</span><strong>{integer(scenarioBCentral.operationsHours)} h</strong></div><div class="capacity"><span>Capacité déclarée</span><strong>{integer(scenarioBCentral.declaredCapacityHours)} h</strong></div></div>
      </details>
      <section class="scenario-break-even" aria-labelledby="break-even-title">
        <figure><Image src={piscine} alt="Piscine naturelle éclairée à l’heure bleue" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 45vw" /><figcaption>Le service intensif ne crée de valeur que si le calendrier conserve assez de capacité.</figcaption></figure>
        <div><p class="demo-kicker">Point mort indicatif</p><h3 id="break-even-title">Environ {money(seasonalBreakEven.averageBasketAtCapacityAfterPrincipalRepayment)} par nuit-suite disponible.</h3><p>Même avec 100 % de remplissage, ce seuil dépasse le panier complet théorique de {money(theoreticalCoupleBasket.total)} avant bar. Le modèle saisonnier ne peut donc pas devenir la structure annuelle de référence.</p></div>
      </section>
      <a class="scenario-model-link" href={withBase("/demo/pilotage?scenario=saisonnier#simulateur")}>Modifier les hypothèses du scénario B</a>
    </section>

    <section id="scenario-c" class="scenario-section scenario-detail scenario-three-suites" aria-labelledby="scenario-c-title">
      <div class="scenario-label"><span>C</span><small>Changement d’échelle</small></div>
      <div class="scenario-detail__intro">
        <div><p class="demo-kicker">Question étudiée · capacité</p><h2 id="scenario-c-title">Changer d’échelle avec la Maisonnette.</h2></div>
        <p><strong>Pourquoi l’étudier ?</strong> Il teste l’hypothèse que la véritable limite du projet n’est ni le prix ni la carte, mais seulement le faible nombre de suites capables d’absorber les coûts fixes et le travail permanent.</p>
      </div>
      <div class="scenario-purpose">
        <article><span>Ce qu’il cherche à prouver</span><p>Qu’une troisième suite vendue dans la même grille permet de financer Jules à temps plein, une relève réelle, le loyer et la restitution de 80 000 € d’avances.</p></article>
        <article><span>Comment il fonctionne</span><p>Le calendrier reste large comme dans A. Le dîner quotidien reste simple ; la table premium devient ponctuelle. Les trois suites partagent le parc, le spa et les équipes.</p></article>
      </div>
      <div class="ambitious-option__hero chapter-visual">
        <figure><Image src={maisonGardien} alt="La Maisonnette du château, envisagée comme troisième suite" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 48vw" /><figcaption><strong>La Maisonnette : troisième suite du même projet.</strong><span>État actuel · travaux estimés à 30 000 €</span></figcaption></figure>
        <div>
          <p class="demo-kicker">Financement familial testé</p>
          <h3>50 k€ de socle + 30 k€ pour la Maisonnette.</h3>
          <div class="scenario-offer-grid compact financing-cards">
            <article><span>Projet initial</span><strong>50 000 €</strong><p>Avances d’associés déjà prévues.</p></article>
            <article><span>Troisième suite</span><strong>+ 30 000 €</strong><p>Avance complémentaire à décider.</p></article>
            <article><span>Remboursement cible</span><strong>16 000 € / an</strong><p>80 k€ sur cinq ans, sans intérêt.</p></article>
          </div>
          <p class="scenario-note standalone"><strong>Prudence :</strong> cinq ans est une ambition de restitution, pas une obligation aveugle. Le remboursement doit rester conditionné à une trésorerie minimale et à la bonne répartition des dépenses entre la SCI et l’exploitation.</p>
        </div>
      </div>
      <div class="scenario-offer-grid compact">
        <article><span>Capacité</span><strong>3 × 150 nuits</strong><p>450 nuits-suite vendues ; 150 nuits par suite.</p></article>
        <article><span>Prix moyen</span><strong>210 € TTC</strong><p>Dans la même grille publique de 180 à 220 €.</p></article>
        <article><span>Offre quotidienne</span><strong>Spa + dîner garanti</strong><p>Garde-manger ou repas partenaire ; table signature ponctuelle.</p></article>
      </div>
      <div class="scenario-kpis ambitious-kpis">
        <article><span>Ventes publiques</span><strong>{money(ambitiousReference.publicRevenueTtc)}</strong><small>{money(ambitiousReference.accountingRevenue)} de produit comptable simulé</small></article>
        <article><span>Travail à organiser</span><strong>{integer(ambitiousReference.operationsHours)} h</strong><small>avec une marge de sécurité de capacité</small></article>
        <article><span>Organisation humaine</span><strong>1 + 0,73 ETP</strong><small>Jules à temps plein + {integer(ambitiousReference.paidReliefHours)} h de relève + 200 h associées</small></article>
        <article class="positive"><span>Solde consolidé comparable</span><strong>{signedMoney(ambitiousReference.cashAfterShareholderAdvanceRepayment)}</strong><small>après 16 000 € de remboursement annuel total</small></article>
      </div>
      <div class="scenario-two-columns implication">
        <div><h3>Ce que ce modèle apporte</h3><ul class="scenario-list positive"><li>La capacité suffisante pour financer un temps plein et une relève structurelle.</li><li>Une meilleure absorption du loyer, des charges fixes et de la commercialisation.</li><li>Une exploitation moins dépendante des heures gratuites de la famille que le scénario A.</li></ul></div>
        <div><h3>Ce qu’il ne résout pas</h3><ul class="scenario-list negative"><li>La relève rémunérée atteint {integer(ambitiousReference.paidReliefHours)} h, soit presque trois quarts d’un second temps plein.</li><li>Le modèle exige 150 nuits vendues par suite et 210 € de prix moyen.</li><li>La marge finale de {money(ambitiousReference.cashAfterShareholderAdvanceRepayment)} reste sensible au prix de la relève, à la durée des séjours et aux 200 h associées.</li></ul></div>
      </div>
      <div class="scenario-lesson"><span>Enseignement C</span><strong>La troisième suite apporte l’échelle économique, mais transforme la relève en deuxième pilier permanent.</strong><p>Elle ne permet pas à Jules de tout faire seul. Elle rend en revanche possible un modèle plus autonome, si les associés mobilisent 30 000 € supplémentaires et croient réellement à 140–150 nuits vendues par suite.</p></div>
      <div class="counterfactual" aria-labelledby="counterfactual-title">
        <div><p class="demo-kicker">Mesurer l’effet réel de la Maisonnette</p><h3 id="counterfactual-title">Même prix, même offre, même prudence : deux suites contre trois.</h3><p>Ce contre-factuel évite d’attribuer à la seule Maisonnette les effets d’un meilleur prix ou d’un volume supérieur par suite.</p></div>
        <div class="counterfactual__grid">
          <article><span>Deux suites · mêmes hypothèses</span><strong>{money(ambitiousTwoSuiteCounterfactual.publicRevenueTtc)}</strong><small>{signedMoney(ambitiousTwoSuiteCounterfactual.cashAfterShareholderAdvanceRepayment)} après remboursement des 50 k€</small></article>
          <article><span>Trois suites · mêmes hypothèses</span><strong>{money(ambitiousReference.publicRevenueTtc)}</strong><small>{signedMoney(ambitiousReference.cashAfterShareholderAdvanceRepayment)} après remboursement des 80 k€</small></article>
          <article class="positive"><span>Effet économique observé</span><strong>+ {money(thirdSuiteRevenueEffect)}</strong><small>de ventes et {signedMoney(thirdSuiteCashEffect)} de solde final</small></article>
        </div>
      </div>
      <details class="scenario-details" open>
        <summary>Voir le calcul de la société d’exploitation</summary>
        <div class="scenario-pnl">{pnlC.map(([label, value, kind]) => <div class:list={["scenario-pnl__row", kind]}><span>{label}</span><strong>{kind === "cost" || kind === "cash" ? `− ${money(Number(value))}` : signedMoney(Number(value)).replace("+ ", "")}</strong></div>)}</div>
        <p class="scenario-note">Avec la ventilation de travail 65 k€ dans la SCI et 15 k€ dans l’exploitation, l’exploitation termine à {signedMoney(ambitiousReference.operatingCompanyCashAfterShareholderAdvanceRepayment)} et la SCI à {signedMoney(ambitiousReference.sciCashBeforeExistingCommitments)} avant ses autres charges. Le solde consolidé est {signedMoney(ambitiousReference.cashAfterShareholderAdvanceRepayment)}.</p>
      </details>
      <div class="ambitious-sensitivity" aria-labelledby="scenario-c-sensitivity">
        <div><p class="demo-kicker">Sensibilité du scénario C</p><h3 id="scenario-c-sensitivity">Cinq ans restent possibles, mais fragiles.</h3><p>Le volume d’activité et la durée de restitution des avances modifient rapidement le coussin disponible.</p></div>
        <div>
          <article class="warn"><span>140 nuits · prix moyen 205 €</span><strong>{signedMoney(ambitiousLowerActivity.cashAfterShareholderAdvanceRepayment)}</strong><p>Équilibre presque exact, sans vraie sécurité.</p></article>
          <article class="positive"><span>150 nuits · prix moyen 210 €</span><strong>{signedMoney(ambitiousReference.cashAfterShareholderAdvanceRepayment)}</strong><p>Cas central ; couverture de {ambitiousReference.coverageOfShareholderAdvanceRepayment.toFixed(2).replace(".", ",")} fois.</p></article>
          <article class="positive"><span>160 nuits · prix moyen 210 €</span><strong>{signedMoney(ambitiousConsolidation.cashAfterShareholderAdvanceRepayment)}</strong><p>Consolidation commerciale, avec {integer(ambitiousConsolidation.paidReliefHours)} h de relève.</p></article>
          <article><span>Même activité · remboursement sur 6 ans</span><strong>{signedMoney(ambitiousSixYearRepayment.cashAfterShareholderAdvanceRepayment)}</strong><p>Plus de sécurité, au prix d’une restitution plus lente.</p></article>
        </div>
      </div>
      <div class="scenario-regulatory">
        <div><p class="demo-kicker">Point à confirmer</p><h3>Une maison d’hôtes, cinq chambres maximum au total.</h3></div>
        <p>La Maisonnette fait partie du château et peut suivre le même accueil. L’ensemble de la maison d’hôtes doit toutefois rester limité à cinq chambres et quinze personnes. Si Lumière et Feuillage comptent déjà quatre chambres physiques, la Maisonnette ne doit en ajouter qu’une.</p>
      </div>
    </section>

    <section id="comparaison" class="scenario-section" aria-labelledby="comparison-title">
      <div class="scenario-section__head">
        <div><p class="demo-kicker">Maintenant seulement : comparer</p><h2 id="comparison-title">Trois scénarios, trois enseignements complémentaires.</h2></div>
        <p>Le tableau utilise un solde consolidé comparable : résultat des deux entités après renouvellement et remboursement de toutes les avances du scénario.</p>
      </div>
      <div class="scenario-scorecard" role="table" aria-label="Comparaison des trois scénarios">
        <div class="scenario-scorecard__head" role="row"><span role="columnheader">Indicateur</span><strong role="columnheader">A · Socle agile</strong><strong role="columnheader">B · Saison signature</strong><strong role="columnheader">C · Trois suites</strong></div>
        {[
          ["Question testée", "simplifier", "intensifier", "changer d’échelle"],
          ["Suites commercialisées", "2 suites", "2 suites", "3 suites"],
          ["Calendrier", "large et flexible", "21 semaines · jeu.–dim.", "large et flexible"],
          ["Nuits vendues / suite", `${scenarioA.soldNightsPerSuite}`, `${scenarioBCentral.soldNightsPerSuite} sur 63`, `${ambitiousReference.soldNightsPerSuite}`],
          ["Nuits-suite totales", `${scenarioA.soldNightsPerSuite * 2}`, `${integer(scenarioBCentral.occupiedSuiteNights)}`, `${integer(ambitiousReference.occupiedSuiteNights)}`],
          ["Prix moyen hébergement", money(scenarioA.averageNightPrice), money(scenarioBCentral.averageNightPrice), money(ambitiousReference.averageNightPrice)],
          ["Panier total / nuit-suite", money(scenarioA.averageBasketPerSuiteNight), money(scenarioBCentral.averageBasketPerSuiteNight), money(ambitiousReference.publicRevenueTtc / ambitiousReference.occupiedSuiteNights)],
          ["Ventes publiques TTC", money(scenarioA.publicRevenue), money(scenarioBCentral.publicRevenue), money(ambitiousReference.publicRevenueTtc)],
          ["Temps total à organiser", `${integer(scenarioA.operationsHours)} h`, `${integer(scenarioBCentral.operationsHours)} h`, `${integer(ambitiousReference.operationsHours)} h`],
          ["Jules financé", "80 %", "75 %", "temps plein"],
          ["Relève rémunérée", "100 h", "150 h", `${integer(ambitiousReference.paidReliefHours)} h`],
          ["Contribution associée", "380 h", "100 h", "200 h"],
          ["Avances à restituer", "50 000 €", "50 000 €", "80 000 €"],
          ["Remboursement annuel cible", "10 000 €", "10 000 €", "16 000 €"],
          ["Solde consolidé comparable", signedMoney(scenarioAConsolidatedCash), signedMoney(scenarioBConsolidatedCash), signedMoney(ambitiousReference.cashAfterShareholderAdvanceRepayment)],
        ].map(([label, a, b, c]) => <div class="scenario-scorecard__row" role="row"><span role="rowheader">{label}</span><strong class:list={{ negative: String(a).startsWith("−") }}>{a}</strong><strong class:list={{ negative: String(b).startsWith("−") }}>{b}</strong><strong class:list={{ negative: String(c).startsWith("−") }}>{c}</strong></div>)}
      </div>
      <p class="scenario-note standalone"><strong>Limite de comparaison :</strong> A et B conservent l’hypothèse fiscale de travail antérieure ; C simule directement la TVA au réel et une marge humaine de 10 %. C est donc volontairement plus prudent. Les chiffres éclairent une décision, ils ne constituent pas une promesse de résultat.</p>
      <div class="scenario-reading-grid comparison-lessons">
        <article><span>A</span><h3>La disponibilité vend.</h3><p>Conserver un calendrier large est plus efficace que multiplier les services. Mais deux suites restent dépendantes d’une forte mobilisation familiale.</p></article>
        <article><span>B</span><h3>La table rend désirable.</h3><p>Elle enrichit fortement l’expérience, mais ne doit pas réduire la capacité ni devenir une contrainte quotidienne permanente.</p></article>
        <article class="ambitious"><span>C</span><h3>La capacité finance la structure.</h3><p>La troisième suite est le meilleur levier économique, à condition de traiter la relève comme un poste essentiel.</p></article>
      </div>
    </section>

    <section id="recommandation" class="scenario-section scenario-recommendation" aria-labelledby="recommendation-title">
      <div class="scenario-recommendation__image"><Image src={petitDejeuner} alt="Projection d’un petit-déjeuner servi sur la terrasse du château" widths={[620, 900, 1200]} sizes="(max-width: 900px) 100vw, 45vw" /></div>
      <div>
        <p class="demo-kicker">Notre recommandation</p>
        <h2 id="recommendation-title">Changer d’échelle sans rendre le service permanent.</h2>
        <p>Le meilleur modèle ne moyenne pas les trois scénarios : il emprunte à chacun ce qu’il démontre de mieux.</p>
        <ol>
          <li><strong>La capacité du scénario C.</strong><span>Trois suites si les associés peuvent mobiliser les 30 000 € supplémentaires.</span></li>
          <li><strong>Le calendrier du scénario A.</strong><span>Une ouverture large et flexible pour préserver le potentiel de nuitées.</span></li>
          <li><strong>La simplicité du scénario A.</strong><span>Un service quotidien facile à produire, largement préparé avant l’arrivée.</span></li>
          <li><strong>La désirabilité du scénario B.</strong><span>Des tables signature sur des dates choisies et annoncées, jamais comme permanence.</span></li>
          <li><strong>Une relève incompressible.</strong><span>À trois suites, plus de 1 000 h payées doivent être considérées comme un vrai poste d’exploitation.</span></li>
        </ol>
      </div>
    </section>

    <section class="scenario-section food-guarantee" aria-labelledby="food-title">
      <div class="scenario-section__head"><div><p class="demo-kicker">Résoudre le vrai irritant client</p><h2 id="food-title">Garantir un dîner, sans cuisiner chaque soir.</h2></div><p>La petite cuisine partagée ne doit pas obliger les hôtes à faire leurs courses. Elle devient un espace de finition pour l’exploitation, pas la promesse principale du séjour.</p></div>
      <div class="food-guarantee__promise"><strong>Promesse client recommandée</strong><span>« Une solution de dîner choisie avant l’arrivée est disponible chaque soir ouvert. »</span></div>
      <div class="food-service-ladder">
        <article><span>Service quotidien</span><h3>Garde-manger du château</h3><strong>Prêt à dresser</strong><p>Planche du territoire, pâté lorrain, salade, dessert et boissons sélectionnées.</p><small>Faible temps de production · stock pilotable</small></article>
        <article><span>Partenariat local</span><h3>Repas livré ou retiré</h3><strong>Précommandé</strong><p>Carte courte négociée avec un traiteur ou restaurateur, remise en température et dressage au château.</p><small>Qualité contractuelle · jours et allergènes documentés</small></article>
        <article><span>Dates choisies</span><h3>Table signature</h3><strong>Expérience premium</strong><p>Menu unique, accords et scénographie sur quelques week-ends rentables.</p><small>Réservation préalable · capacité limitée</small></article>
        <article><span>Solution de secours</span><h3>Sélection locale fiable</h3><strong>Réservée pour l’hôte</strong><p>Liste très courte d’adresses testées, horaires confirmés et réservation effectuée en amont.</p><small>Jamais une simple liste de liens abandonnée au client</small></article>
      </div>
    </section>

    <section class="scenario-section decision-path" aria-labelledby="path-title">
      <div class="scenario-section__head"><div><p class="demo-kicker">La décision selon notre capacité financière</p><h2 id="path-title">Deux chemins cohérents, pas trois compromis flous.</h2></div><p>Le scénario B devient une brique d’expérience. La véritable décision porte sur la mobilisation ou non des 30 000 € supplémentaires.</p></div>
      <div class="decision-path__grid">
        <article><span>Si les 30 k€ ne sont pas mobilisables</span><h3>Lancer le socle agile à deux suites.</h3><p>Conserver un calendrier large, garantir une solution de dîner légère et accepter au moins l’un des trois arbitrages : rémunération partielle de Jules, implication familiale élevée ou remboursement plus lent.</p><strong>Point de travail : 120–135 nuits par suite</strong></article>
        <article class="preferred"><span>Si les 30 k€ sont mobilisables</span><h3>Préparer directement les trois suites.</h3><p>Adopter l’offre hybride, viser 140–150 nuits par suite, financer Jules à temps plein et contractualiser la relève avant l’ouverture.</p><strong>Point de travail : 150 nuits · 210 € de moyenne</strong></article>
      </div>
      <div class="activity-ladder__table compact-ladder" role="table" aria-label="Sensibilité du scénario à deux suites">
        <div class="activity-ladder__head" role="row"><span role="columnheader">Deux suites · activité</span><span role="columnheader">60 nuits</span><span role="columnheader">90 nuits</span><span role="columnheader">120 nuits</span><span role="columnheader">150 nuits</span></div>
        {[
          ["Ventes publiques TTC", ...hybridActivityCases.map((item) => money(item.publicRevenue))],
          ["Jules rémunéré", ...hybridActivityCases.map((item) => fteLabel(item.julesFte))],
          ["Temps encore non couvert", ...hybridActivityCases.map((item) => `${integer(item.staffingGapHours)} h`)],
          ["Trésorerie exploitation", ...hybridActivityCases.map((item) => signedMoney(item.cashAfterPrincipalRepayment))],
        ].map(([label, ...values]) => <div class="activity-ladder__row" role="row"><strong role="rowheader">{label}</strong>{values.map((value) => <span>{value}</span>)}</div>)}
      </div>
      <p class="scenario-correction"><strong>Lecture :</strong> 60 à 90 nuits constituent un pilote familial, pas une exploitation autonome. À deux suites, la première zone crédible apparaît vers 120–135 nuits avec des arbitrages humains forts. À trois suites, 140 nuits à 205 € restent presque au point mort ; 150 nuits à 210 € créent le premier coussin réellement exploitable.</p>
    </section>

    <section id="decisions" class="scenario-section scenario-decisions" aria-labelledby="decisions-title">
      <div class="scenario-section__head"><div><p class="demo-kicker">Décisions à prendre entre associés</p><h2 id="decisions-title">Ce qu’il faut valider pour choisir le modèle.</h2></div><p>Ces questions déterminent davantage la viabilité que quelques euros gagnés sur un coût unitaire.</p></div>
      <div class="decision-list">
        <article><span>01</span><h3>Mobiliser ou non 30 k€</h3><p>Décider si la Maisonnette entre dans le périmètre dès le lancement.</p></article>
        <article><span>02</span><h3>Fixer l’ambition commerciale</h3><p>Assumer ou non une cible de 140–150 nuits vendues par suite.</p></article>
        <article><span>03</span><h3>Garantir la relève</h3><p>Identifier qui couvre les heures payées et les 200 h associées du modèle C.</p></article>
        <article><span>04</span><h3>Choisir le rythme de remboursement</h3><p>Conserver cinq ans comme cible, avec possibilité de ralentir pour protéger la trésorerie.</p></article>
        <article><span>05</span><h3>Valider l’offre alimentaire</h3><p>Dîner garanti, garde-manger quotidien et table signature ponctuelle.</p></article>
        <article><span>06</span><h3>Confirmer le cadre des chambres</h3><p>Vérifier le plafond de cinq chambres physiques pour les trois suites.</p></article>
      </div>
      <div class="decision-final-cta"><div><p class="demo-kicker">Étape suivante</p><h3>Modifier les hypothèses, puis documenter l’arbitrage familial.</h3></div><div><a class="demo-button" href={withBase("/demo/pilotage?scenario=socle#simulateur")}>Simuler le socle agile</a><a class="demo-button secondary" href={withBase("/demo/pilotage?scenario=saisonnier#simulateur")}>Simuler la saison signature</a><a class="demo-button quiet" href={withBase("/demo/pilotage?scenario=libre#simulateur")}>Créer un scénario libre</a></div></div>
    </section>

    <footer class="scenario-method">
      <strong>Méthode et limites.</strong>
      <p>Ces modèles sont des outils de décision, pas des prévisions. Les coûts, taux d’achat, temps de travail, régime de TVA et règles de remboursement doivent être remplacés progressivement par des devis, tests et décisions formelles. Le seul financement modélisé est le compte courant d’associé sans intérêt. Les projections visuelles représentent une intention après travaux.</p>
      <div><a href={withBase("/knowledge/operating-scenarios.json")}>Données structurées des scénarios</a><a href={withBase("/demo/pilotage#referentiel")}>Consulter la modélisation et ses sources</a></div>
    </footer>
  </div>
  <script is:inline>
    document.querySelector("[data-scenario-share]")?.addEventListener("click", async () => {
      const url = window.location.href.split("#")[0];
      try { await navigator.clipboard.writeText(url); window.CSLDemo?.toast("Le lien d’aide à la décision est copié."); }
      catch (_) { window.prompt("Copiez ce lien :", url); }
    });
  </script>
</DemoLayout>
