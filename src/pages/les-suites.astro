---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import SuiteCard from "../components/suites/SuiteCard.astro";
import CtaFinal from "../components/CtaFinal.astro";
import { tarifs } from "../data/tarifs";

const suites = (await getCollection("suites")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Les Suites | Les Nuits au Château"
  description="Deux suites seulement — Lumière et Feuillage — dans un château familial de 1876 à Rambervillers. Deux pièces, une salle de bain et une terrasse privative chacune. Ouverture avril 2027."
  ogType="article"
>
  <PageHero
    place="Les Suites de Sainte-Lucie"
    title={["Deux manières", "d'habiter la nuit."]}
    lead="Deux suites seulement, chacune composée de deux pièces, d'une salle de bain et d'une terrasse privative. Deux atmosphères différentes, un même rapport à la matière, au calme et à la lumière."
    image="projLumiereSalon"
    imageAlt="Le salon privé de la Suite Lumière, projeté après travaux"
    imagePosition="center 52%"
    actions={[{ label: "Être informé de l'ouverture", href: "/contact", variant: "gold-light" }]}
  />

  <section class="sec suites-page">
    <div class="wrap">
      <div class="suites-grid">
        {
          suites.map((s) => (
            <SuiteCard
              href={`/${s.id}`}
              image={s.data.cardImage}
              imagePosition={s.data.cardPosition}
              name={s.data.name}
              title={s.data.nav}
              tagline={s.data.tagline}
              ambiance={s.data.ambiance}
            />
          ))
        }
      </div>
      <p class="note suites-note">
        Les visuels présentent l'intention d'aménagement après travaux. Les
        équipements détaillés seront précisés à l'ouverture des réservations.
      </p>
      <div class="suite-essentials" aria-label="Les essentiels du séjour">
        <span><strong>2</strong> suites seulement</span>
        <span><strong>2</strong> pièces par suite</span>
        <span><strong>1</strong> terrasse privative</span>
        <span><strong>250 €</strong> la nuit pour deux</span>
      </div>
    </div>
  </section>

  <section class="sec tarifs">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow"><span class="ln"></span>{tarifs.eyebrow}</p>
        <h2 class="display-l">{tarifs.title[0]}<em class="gold">{tarifs.title[1]}</em></h2>
        <p class="lede">{tarifs.intro}</p>
      </div>
      <ul class="tarifs-list">
        {
          tarifs.items.map((it) => (
            <li class="tarif">
              <div class="tarif__label">
                <span class="tarif__name">{it.label}</span>
                <span class="tarif__note">{it.note}</span>
              </div>
              <div class="tarif__price">
                {it.value}<span class="tarif__unit">{it.unit}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="note tarifs-note">{tarifs.note}</p>
    </div>
  </section>

  <CtaFinal
    eyebrow="Pré-ouverture · avril 2027"
    titleLead="Une nuit vous attend "
    titleGold="au château."
    text="Laissez-nous vos coordonnées pour être informé de l'ouverture des réservations."
    actions={[{ label: "Être informé de l'ouverture", href: "/contact", variant: "gold-light" }]}
  />
</BaseLayout>

<style>
  .suites-page {
    background: var(--parch);
  }
  .suites-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  @media (min-width: 820px) {
    .suites-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .suites-note {
    margin-top: 30px;
    text-align: center;
  }
  .suite-essentials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 34px;
    border: 1px solid var(--rule-l-faint);
    background: var(--rule-l-faint);
    gap: 1px;
  }
  .suite-essentials span {
    background: var(--parch-card);
    padding: 20px;
    color: var(--encre-soft);
    text-align: center;
    font-size: 14px;
  }
  .suite-essentials strong {
    display: block;
    font-family: var(--display);
    font-size: 30px;
    font-weight: 500;
    color: var(--or-prof);
    line-height: 1;
    margin-bottom: 5px;
  }
  @media (min-width: 760px) {
    .suite-essentials { grid-template-columns: repeat(4, 1fr); }
  }

  /* Tarifs */
  .tarifs {
    background: var(--parch-2);
  }
  .tarifs-list {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    max-width: 720px;
    border-top: 1px solid var(--rule-l-faint);
  }
  .tarif {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule-l-faint);
  }
  .tarif__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tarif__name {
    font-family: var(--display);
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--encre);
    line-height: 1.1;
  }
  .tarif__note {
    font-size: 14px;
    color: var(--encre-faint);
  }
  .tarif__price {
    font-family: var(--display);
    font-size: clamp(22px, 2.6vw, 30px);
    color: var(--or-prof);
    white-space: nowrap;
    line-height: 1;
  }
  .tarif__unit {
    font-family: var(--serif);
    font-size: 14px;
    color: var(--encre-faint);
    letter-spacing: 0.02em;
    margin-left: 6px;
  }
  .tarifs-note {
    margin-top: 22px;
    max-width: 720px;
  }
</style>
