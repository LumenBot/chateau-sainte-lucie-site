---
import "../styles/global.css";
import "../styles/demo.css";
import BaseHead from "../components/BaseHead.astro";
import Blason from "../components/brand/Blason.astro";
import { withBase } from "../utils/url";

interface Props {
  title: string;
  description: string;
  section?: "accueil" | "reservation" | "client" | "gestion" | "pilotage" | "scenarios" | "integrations";
}

const { title, description, section = "accueil" } = Astro.props;
const demoNav = [
  { key: "accueil", label: "Vue d’ensemble", href: "/demo" },
  { key: "reservation", label: "Réservation", href: "/demo/reservation" },
  { key: "client", label: "Espace client", href: "/demo/client" },
  { key: "gestion", label: "Gestion", href: "/demo/gestion" },
  { key: "pilotage", label: "Base de vérité", href: "/demo/pilotage" },
  { key: "scenarios", label: "Scénarios", href: "/demo/scenarios" },
  { key: "integrations", label: "Intégrations", href: "/demo/integrations" },
] as const;
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={title} description={description} noindex={true} />
  </head>
  <body class="demo-body">
    <a class="skip-link" href="#contenu-demo">Aller au contenu</a>
    <div class="demo-ribbon" role="status">
      {section === "pilotage" || section === "scenarios" ? "Espace associés · données projet non sensibles · aucune transaction" : "Démonstrateur fonctionnel · données fictives · aucune transaction réelle"}
    </div>
    <header class="demo-header">
      <a class="demo-brand" href={withBase("/demo")} aria-label="Accueil du démonstrateur">
        <Blason variant="or" width={52} loading="eager" />
        <span>
          <strong>Les Nuits au Château</strong>
          <small>Atelier de l’expérience numérique</small>
        </span>
      </a>
      <nav class="demo-nav" aria-label="Navigation du démonstrateur">
        {demoNav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={{ active: section === item.key }}
            aria-current={section === item.key ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="demo-header-actions">
        {section !== "pilotage" && section !== "scenarios" && <button class="demo-reset" type="button" data-demo-reset>Réinitialiser</button>}
        <a class="demo-exit" href={withBase("/")}>Retour au site</a>
      </div>
    </header>
    <main id="contenu-demo" class="demo-main">
      <slot />
    </main>
    <footer class="demo-footer">
      <p>Prototype de travail destiné aux associés · version août 2026</p>
      <p>Les parcours, tarifs et règles sont simulés à partir du référentiel validé.</p>
    </footer>
    <div class="demo-toast" data-demo-toast role="status" aria-live="polite"></div>
    <script is:inline src={withBase("/demo/demo-core.js")}></script>
  </body>
</html>
