  "recommended_sustainable_configuration": {
    "horizon": "2029_plus_maturity",
    "status": "target_to_test_not_guarantee",
    "jules_fte_funded_by_opco": 0.7,
    "paid_support_hours": 400,
    "declared_family_hours": 60,
    "contractual_sci_rent": 0,
    "renewal_cash_allocation": 4000,
    "annual_cash_reserve_contribution": 3000,
    "interpretation": "Near break-even target for two suites. It does not finance a full-time Jules position and a significant SCI rent simultaneously. The 60 unpaid family hours must be accepted explicitly or replaced with paid cover."
  },
  "full_time_and_rent_goal": {
    "jules_fte": 1,
    "target_sci_rent": 10000,
    "required_public_sales_ttc_range": [110000, 123000],
    "status": "sensitivity_estimate",
    "examples": [
      { "nights_per_suite": 150, "average_public_price_ttc_approx": 314 },
      { "nights_per_suite": 159, "average_public_price_ttc_approx": 300 },
      { "nights_per_suite": 173, "average_public_price_ttc_approx": 280 },
      { "nights_per_suite": 211, "average_public_price_ttc_approx": 240 }
    ],
    "interpretation": "Mathematically possible at two suites, but not commercially demonstrated by the current benchmark or price grid."
  },
  "variable_cost_assumptions": {
    "turnover_cleaning_linen_welcome_per_stay_ttc": { "value": 90, "status": "quote_required" },
    "breakfast_per_guest_night_ttc": { "value": 7, "range": [6, 9], "status": "test_required" },
    "energy_per_suite_night_ttc": { "value": 7.5, "range": [7, 12], "status": "measurement_required" },
    "spa_direct_cost_per_sale_ttc": { "value": 24, "range": [20, 35], "status": "measurement_required" },
    "dining_material_rate_of_ttc_sales": { "value": 0.35, "range": [0.3, 0.38], "status": "menu_costing_required" },
    "ota_commission_rate": { "value": 0.15, "range": [0.15, 0.18], "status": "contract_required" },
    "direct_payment_rate": { "value": 0.015, "range": [0.015, 0.02], "status": "provider_quote_required" },
    "incidents_and_commercial_gestures_rate": { "value": 0.007, "status": "working_assumption" }
  },
  "fixed_operating_cost_budget_ttc": {
    "central_total": 18000,
    "stress_range": [15000, 22000],
    "status": "itemized_working_assumption_all_quotes_required",
    "lines": {
      "insurance": 1500,
      "accounting_and_payroll": 3000,
      "pms_site_and_telecom": 2400,
      "acquisition_and_communication": 2000,
      "cfe_licences_and_mediation": 1200,
      "bank_fixed": 400,
      "safety_and_controls": 700,
      "technical_maintenance": 2800,
      "fixed_spa_maintenance": 2400,
      "water_waste_and_energy_base": 1000,
      "training_and_prevention": 600
    },
    "allocation_rule": "Each line must be assigned to OpCo, SCI or shared according to the lease and actual beneficiary."
  },
  "workload_model": {
    "presence_days": "1.2 * nights_per_suite; heuristic pending real booking calendar",
    "operations_hours": "720 + 1.75 * presence_days + 0.5 * occupied_suite_nights + stays + 0.75 * spa_sales + 4.5 * dining_sales",
    "calendar_support_floor": "round_to_50(100 + 2 * nights_per_suite), bounded between 250 and 500 hours",
    "support_hours": "max(planned_support, calendar_support_floor, operations_hours - paid_jules_capacity - declared_family_hours)",
    "jules_paid_capacity": "1607 * funded_fte * employed_months / 12",
    "warning": "Annual heuristics do not replace a weekly roster respecting daily and weekly rest."
  },
  "result_model": {
    "operating_result_before_rent": "accounting_revenue - variable_costs - fixed_operating_costs - jules_employer_cost - paid_support_cost",
    "operating_result_after_rent": "operating_result_before_rent - contractual_sci_rent",
    "prudent_cash_balance": "operating_result_after_rent - renewal_allocation - annual_cash_reserve_contribution",
    "maximum_economic_rent_capacity": "max(0, operating_result_before_rent - renewal_allocation - annual_cash_reserve_contribution)"
  },
  "interpretation_rules": [
    "The public launch range remains 180 to 220 EUR. A 240 EUR average at maturity requires a formally approved higher price grid and evidence from real demand.",
    "The 18k fixed-cost budget is a diligence estimate, not a verified fact; possible duplicates and SCI allocations must be resolved.",
    "The 28k full-time employer budget is provisional and requires an Urssaf simulation, payroll quote and collective-agreement review.",
    "A third unit is a strategic option, not a proven necessity. Its exact room count must preserve or intentionally leave the legal chambre-d'hotes scope.",
    "Debt, depreciation, corporate tax and owner remuneration are outside this simplified annual model."
  ],
