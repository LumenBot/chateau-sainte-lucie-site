  "purpose": "Transparent two-suite operating model for collective decision-making; not an accountant-approved forecast",
  "currency": "EUR",
  "doctrine": {
    "public_prices_are_ttc": true,
    "contractual_sci_rent_is_an_input": true,
    "operating_result_is_the_residual": true,
    "maximum_rent_capacity_is_only_an_economic_indicator": true,
    "renewal_and_cash_reserve_are_separated_from_operating_expenses": true,
    "every_unpaid_family_hour_must_be_declared": true,
    "status": "active"
  },
