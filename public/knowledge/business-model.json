{
  "schema_version": "2.0",
  "as_of": "2026-08-09",
  "purpose": "Transparent annual operating simulator, not an accountant-approved forecast",
  "currency": "EUR",
  "fixed_parameters": {
    "suite_count": 2,
    "average_guests": 2.1,
    "jules_full_time_employer_budget": 28000,
    "jules_full_time_employer_budget_status": "provisional_working_assumption_to_validate_with_urssaf_and_payroll_quote",
    "legal_full_time_hours": 1607,
    "useful_capacity_for_planning": 1350,
    "initial_capex": 65000,
    "initial_capex_treatment": "fixed and excluded from annual P&L and SCI rent formula"
  },
  "recommended_scenario": {
    "status": "stabilized_target_not_first_year_guarantee",
    "nights_per_suite": 155,
    "average_night_price": 235,
    "average_length_of_stay": 2.4,
    "direct_booking_share": 0.65,
    "spa_take_rate": 0.6,
    "spa_average_basket_per_buying_stay": 80,
    "dining_take_rate": 0.3,
    "dining_average_basket_per_buying_stay": 170,
    "support_mode": "hourly_outsourcing",
    "support_hourly_rate": 25,
    "operating_reserve_before_sci_rent": 5000,
    "indicative_outputs": {
      "annual_revenue": 85638,
      "annual_support_hours": 158,
      "annual_support_cost": 3938,
      "maximum_sustainable_sci_rent": 17045
    }
  },
  "editable_activity_parameters": [
    "nights_per_suite",
    "average_night_price",
    "average_length_of_stay",
    "direct_booking_share",
    "spa_take_rate",
    "spa_average_basket_per_buying_stay",
    "dining_take_rate",
    "dining_average_basket_per_buying_stay"
  ],
  "editable_cost_parameters": {
    "turnover_cleaning_linen_welcome_per_stay": 90,
    "breakfast_per_guest_night": 7,
    "energy_per_suite_night": 7.5,
    "spa_direct_cost_per_sale": 24,
    "dining_direct_cost_per_sale": 60,
    "ota_commission_rate": 0.15,
    "miscellaneous_operating_cost_rate_of_revenue": 0.06,
    "operating_reserve_before_sci_rent": 5000
  },
  "formulas": {
    "occupied_suite_nights": "2 * nights_per_suite",
    "stays": "occupied_suite_nights / average_length_of_stay",
    "lodging_revenue": "occupied_suite_nights * average_night_price",
    "spa_revenue": "stays * spa_take_rate * spa_average_basket_per_buying_stay",
    "dining_revenue": "stays * dining_take_rate * dining_average_basket_per_buying_stay",
    "variable_costs": "OTA commissions + turnover + breakfast + energy + spa direct cost + dining direct cost + miscellaneous operating costs",
    "internal_operations_hours": "720 + occupied_suite_nights * 0.65 + stays + spa_sales * 0.75 + dining_sales * 4.5",
    "minimum_relief_hours": "80 + nights_per_suite * 0.5",
    "support_hours": "max(minimum_relief_hours, internal_operations_hours - 1350, 0)",
    "hourly_support_cost": "support_hours * hourly_rate",
    "part_time_support_fte": "max(0.2, round_up_to_0.1(support_hours / 1607))",
    "part_time_support_cost": "part_time_support_fte * 28000",
    "maximum_sustainable_sci_rent": "max(0, revenue - variable_costs - 28000 - support_cost - operating_reserve)",
    "remaining_deficit": "max(0, -(revenue - variable_costs - 28000 - support_cost - operating_reserve))"
  },
  "interpretation_rules": [
    "SCI rent is an economic contribution capacity, not a validated legal or fiscal market rent.",
    "When obligations are not covered, SCI rent is zero and the remaining deficit is shown; no negative rent is created.",
    "Turnover cost includes externalized cleaning, linen and welcome consumables; cleaning hours are therefore excluded from internal workload.",
    "Miscellaneous operating costs are a revenue percentage for unallocated recurring costs and must be replaced by actual accounting data.",
    "All assumptions must be replaced by invoices, payroll simulations and measured operating times after launch."
  ],
  "official_validation_links": [
    "https://mon-entreprise.urssaf.fr/simulateurs/salaire-brut-net?view=employeur",
    "https://www.urssaf.fr/accueil/employeur/cotisations/comprendre-cotisations/calcul-cotisations-employeur.html",
    "https://www.service-public.fr/particuliers/vosdroits/F1911"
  ]
}
